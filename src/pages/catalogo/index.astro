---
import Base from '@/layouts/Base.astro';
import SelectorCta from '@/components/selector/SelectorCta.astro';
import { getCollection } from 'astro:content';
import { TIPOS, TIPOS_CON_DATOS } from '@/lib/tipos';
import { catalogPath, type Producto } from '@/lib/productos';
import { absoluteUrl, buildAlternates } from '@/i18n/routes';
import { SELECTOR_CONFIGS, resolveEligibleSelectorConfigs } from '@/lib/selector/config';

const productos = await getCollection('productos');
const conteo = (tipo: string) => productos.filter((p) => p.data.tipo === tipo).length;
const tarjetas = TIPOS_CON_DATOS.map((slug) => ({ cfg: TIPOS[slug], n: conteo(slug) }));
const selectorProducts = productos.map((e) => ({
  slug: e.id.replace(/\.(ya?ml|json)$/, ''),
  ...e.data,
})) as Producto[];
const eligibleSelectorConfigs = resolveEligibleSelectorConfigs(SELECTOR_CONFIGS, selectorProducts, 5);
const titulo = 'Catálogo para home office | Tu Espacio de Trabajo';
const descripcion = 'Base de datos comparativa de equipamiento de home office: sillas ergonómicas y más, con specs verificadas, valoración por ejes y comparador.';
const pagePath = catalogPath('es-ES');
const alternates = buildAlternates({
  'es-ES': pagePath,
  en: catalogPath('en'),
});
---
<Base title={titulo} description={descripcion} canonical={absoluteUrl(pagePath)} alternates={alternates}>
  <div class="container" style="padding: 2rem 0;">
    <nav class="breadcrumb" aria-label="Migas de pan"><a href="/">Inicio</a> › <span>Catálogo</span></nav>
    <h1>Catálogo</h1>
    <p class="cat-sub">Specs verificadas, valoración por ejes y comparador. Elige una categoría.</p>
    {eligibleSelectorConfigs.length > 0 && <SelectorCta locale="es-ES" variant="compact" />}
    <div class="cat-hub">
      {tarjetas.map(({ cfg, n }) => (
        <a class="cat-hub-card" href={`/catalogo/${cfg.slug}/`}>
          <span class="cat-hub-ico" aria-hidden="true">{cfg.icono}</span>
          <span class="cat-hub-tit">{cfg.labelPlural}</span>
          <span class="cat-hub-n">{n} productos</span>
        </a>
      ))}
    </div>
  </div>
</Base>
<style>
  .cat-sub { color: var(--ink-muted); margin-bottom: 2rem; }
  .cat-hub { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; }
  .cat-hub-card { display: flex; flex-direction: column; gap: 0.3rem; padding: 1.5rem; border: 1px solid var(--border); border-radius: var(--radius); text-decoration: none; color: inherit; transition: border-color .15s, transform .15s; }
  .cat-hub-card:hover { border-color: var(--accent); transform: translateY(-2px); }
  .cat-hub-ico { font-size: 2rem; }
  .cat-hub-tit { font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; }
  .cat-hub-n { color: var(--ink-muted); font-size: 0.85rem; }
</style>
