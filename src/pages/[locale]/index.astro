---
import Base from '@/layouts/Base.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import CategoryIcon from '@/components/CategoryIcon.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { READY_LOCALES, type Locale } from '@/i18n/locales';
import { absoluteUrl, articlePath, buildAlternates, localizedPath, pathLocaleSegment } from '@/i18n/routes';

export async function getStaticPaths() {
  return READY_LOCALES
    .filter(locale => locale !== 'es-ES')
    .map(locale => ({ params: { locale: pathLocaleSegment(locale) }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
const articles = await getCollection('articulosI18n', ({ data }) => data.locale === locale);
const alternates = buildAlternates({
  'es-ES': localizedPath('es-ES'),
  [locale]: localizedPath(locale),
});

const pillarSourceSlugs = [
  'mejor-silla-ergonomica-calidad-precio',
  'mejor-escritorio-elevable-electrico',
  'mejor-monitor-trabajar-desde-casa',
  'mejor-raton-vertical-ergonomico',
  'mejor-teclado-ergonomico',
  'mejor-lampara-escritorio-led',
  'mejor-ventilador-silencioso-oficina',
  'ikea-bekant-vs-flexispot-e7',
];
const pillars = pillarSourceSlugs
  .map(slug => articles.find(a => a.data.translationOf === slug))
  .filter((a): a is NonNullable<typeof a> => Boolean(a));

const orderedByDate = [...articles].sort(
  (a, b) => b.data.fecha.getTime() - a.data.fecha.getTime()
);

const categoryNames: Record<string, string> = {
  sillas: 'Chairs',
  escritorios: 'Desks',
  accesorios: 'Accessories',
  ambiente: 'Workspace',
  'audio-video': 'Audio and video',
};

const hrefFor = (article: CollectionEntry<'articulosI18n'>) =>
  articlePath({
    locale,
    tipo: article.data.tipo,
    categoriaSlug: article.data.categoriaSlug,
    slug: article.data.localizedSlug,
  });

const categoryName = (article: CollectionEntry<'articulosI18n'>) =>
  article.data.tipo === 'informativo'
    ? 'Guide'
    : article.data.tipo === 'noticia'
      ? 'News'
      : (categoryNames[article.data.categoria] ?? article.data.categoria);

const shortDate = (article: CollectionEntry<'articulosI18n'>) =>
  (article.data.actualizadoEn || article.data.fecha).toLocaleDateString('en-US', {
    day: 'numeric',
    month: 'short',
  });

const pillarSlugSet = new Set(pillars.map(article => article.data.translationOf));
const latest = orderedByDate
  .filter(article => !pillarSlugSet.has(article.data.translationOf))
  .slice(0, 6);

const recent = orderedByDate.slice(0, 6);

const siteUrl = 'https://tuespaciodetrabajo.com';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Tu Espacio de Trabajo',
  url: siteUrl,
  logo: {
    '@type': 'ImageObject',
    url: `${siteUrl}/favicon.svg`,
    width: 512,
    height: 512,
  },
  description: 'Buying guides and comparisons for home office and ergonomic products for remote workers',
  contactPoint: {
    '@type': 'ContactPoint',
    email: 'contacto@tuespaciodetrabajo.com',
    contactType: 'customer service',
    availableLanguage: ['es', 'en'],
  },
  foundingDate: '2026',
  areaServed: {
    '@type': 'Country',
    name: 'ES',
  },
  availableLanguage: ['es', 'en'],
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Latest home office product reviews',
  numberOfItems: recent.length,
  itemListElement: recent.map((article, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: absoluteUrl(hrefFor(article)),
    name: article.data.titulo,
  })),
};

const categories = [
  {
    area: 'sillas',
    href: localizedPath(locale, ['chairs']),
    icon: 'sillas',
    name: 'Chairs',
    description: 'Ergonomic, gaming, office and budget chairs',
    count: articles.filter(article => article.data.categoria === 'sillas').length,
  },
  {
    area: 'escritorios',
    href: localizedPath(locale, ['desks']),
    icon: 'escritorios',
    name: 'Desks',
    description: 'Standing desks, regular desks, corner desks and small-space setups',
    count: articles.filter(article => article.data.categoria === 'escritorios').length,
  },
  {
    area: 'accesorios',
    href: localizedPath(locale, ['accessories']),
    icon: 'accesorios',
    name: 'Accessories',
    description: 'Keyboards, mice, monitor arms, wrist rests and more',
    count: articles.filter(article => article.data.categoria === 'accesorios').length,
  },
  {
    area: 'ambiente',
    href: localizedPath(locale, ['workspace']),
    icon: 'ambiente',
    name: 'Workspace',
    description: 'Lighting, cable management, noise control and setup comfort',
    count: articles.filter(article => article.data.categoria === 'ambiente').length,
  },
  {
    area: 'guias',
    href: localizedPath(locale, ['guides']),
    icon: 'guias',
    name: 'Guides',
    description: 'Ergonomics, productivity and home office organization advice',
    count: articles.filter(article => article.data.tipo === 'informativo').length,
  },
];
---

<Base
  title="Tu Espacio de Trabajo · Home office guides and comparisons"
  description="Comparisons of ergonomic chairs, desks and accessories for your home office. Everything you need to work from home better."
  canonical={absoluteUrl(localizedPath(locale))}
  alternates={alternates}
  locale={locale}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(itemListSchema)} slot="head" />

  <section class="home-hero">
    <div class="container">
      <div class="home-hero-grid">
        <div class="home-hero-text">
          <h1 class="home-hero-title">I test home office gear so you do not buy the wrong setup.</h1>
          <p class="home-hero-sub">I have worked remotely since 2019. I compare chairs, desks and accessories with technical criteria and many hours of real daily use.</p>
          <div class="home-hero-cta">
            <a href={localizedPath(locale, ['articles'])} class="hero-cta-btn hero-cta-primary">
              View comparisons
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <a href={localizedPath(locale, ['about'])} class="hero-cta-btn hero-cta-secondary">How I test</a>
          </div>
        </div>
        <figure class="home-hero-figure">
          <img src="/images/articulos/setup-home-office-escritorio-elevable.webp" alt="Standing desk with monitor, ergonomic chair and accessories in a real home office" width="800" height="600" fetchpriority="high" decoding="async" />
        </figure>
      </div>
    </div>
  </section>

  <section class="section home-bento-section">
    <div class="container">
      <h2 class="section-title">Explore by category</h2>
      <p class="section-subtitle">Chairs, desks and everything your body touches for eight hours a day.</p>
      <div class="home-bento">
        {categories.map(category => (
          <a href={category.href} class={`home-bento-cell home-bento-cell--${category.area}`} style={`grid-area: ${category.area};`}>
            <span class="home-bento-icon" aria-hidden="true"><CategoryIcon categoria={category.icon} size={category.area === 'sillas' ? 36 : 26} /></span>
            <span class="home-bento-name">{category.name}</span>
            {category.area === 'sillas' && <span class="home-bento-desc">{category.description}</span>}
            <span class="home-bento-count">{category.count > 0 ? `${category.count} reviews` : 'Coming soon'}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {pillars.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <div class="section-header">
          <span class="section-eyebrow">Comparisons</span>
          <h2 class="section-title">In-depth comparisons, not lists copied from Amazon.</h2>
          <p class="section-subtitle">I test, measure and compare each product before recommending it. I start with what punishes your back most: chairs and desks.</p>
          <a href={localizedPath(locale, ['catalog'])} class="home-inline-link">View the comparison catalog</a>
        </div>
        <div class="articles-grid">
          {pillars.map((article, index) => (
            <ArticleCard articulo={article} locale={locale} revealDelay={index * 50} />
          ))}
        </div>
      </div>
    </section>
  )}

  {latest.length > 0 && (
    <section class="section">
      <div class="container">
        <h2 class="section-title">The latest articles I have published</h2>
        <p class="section-subtitle">Fresh guides and reviews, ordered by publication date.</p>
        <div class="home-index">
          {latest.map(article => (
            <a href={hrefFor(article)} class="home-index-item">
              <span class="home-index-title">{article.data.titulo}</span>
              <span class="home-index-meta">{categoryName(article)} · {shortDate(article)}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section section--alt">
    <div class="container">
      <div class="home-method-grid">
        <div class="home-method-intro">
          <h2 class="section-title">How I test what I recommend</h2>
          <p class="home-method-lead">
            I am David Rubio, a software engineer. I have worked remotely since 2019 and spend seven to eight hours a day in the same chair, so home office gear matters to me for selfish reasons before professional ones.
          </p>
          <a href={localizedPath(locale, ['about'])} class="home-inline-link">About me and my method</a>
        </div>
        <ul class="home-method-list">
          <li>I test the gear in my own workspace, not in a borrowed test room.</li>
          <li>I read specs with technical criteria and verify measurements. I do not copy Amazon text.</li>
          <li>I check ergonomics forums and consult my physiotherapist before recommending postural gear.</li>
          <li>I am not paid to place a product in a position. If I have not tested it, I say so.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section-tool-banner">
    <div class="container">
      <a class="tool-banner" href={localizedPath(locale, ['tools', 'ergonomic-calculator'])}>
        <div class="tool-banner-content">
          <span class="tool-banner-eyebrow">Free tool</span>
          <h2 class="tool-banner-title">Ergonomic calculator</h2>
          <p class="tool-banner-text">
            Enter your height and I will tell you the exact height for your chair, desk and monitor. Includes an interactive figure and category-based recommendations.
          </p>
          <span class="tool-banner-cta">Try the calculator →</span>
        </div>
        <div class="tool-banner-figure" aria-hidden="true">
          <svg viewBox="0 0 200 180" xmlns="http://www.w3.org/2000/svg">
            <line x1="10" y1="160" x2="190" y2="160" stroke="currentColor" stroke-width="2" opacity="0.25"/>
            <rect x="105" y="85" width="80" height="4" fill="currentColor" opacity="0.55"/>
            <line x1="180" y1="89" x2="180" y2="160" stroke="currentColor" stroke-width="2.5" opacity="0.5"/>
            <rect x="115" y="40" width="60" height="45" rx="2" fill="currentColor" opacity="0.2"/>
            <rect x="35" y="115" width="55" height="4" fill="currentColor" opacity="0.55"/>
            <rect x="35" y="78" width="4" height="41" fill="currentColor" opacity="0.55"/>
            <line x1="62" y1="119" x2="62" y2="158" stroke="currentColor" stroke-width="1.5" opacity="0.5"/>
            <circle cx="75" cy="60" r="12" fill="currentColor" opacity="0.85"/>
            <rect x="61" y="72" width="28" height="45" rx="5" fill="currentColor" opacity="0.8"/>
            <line x1="87" y1="85" x2="120" y2="87" stroke="currentColor" stroke-width="6" stroke-linecap="round" opacity="0.8"/>
            <line x1="74" y1="119" x2="118" y2="119" stroke="currentColor" stroke-width="7" stroke-linecap="round" opacity="0.8"/>
            <line x1="118" y1="119" x2="118" y2="158" stroke="currentColor" stroke-width="6" stroke-linecap="round" opacity="0.8"/>
          </svg>
        </div>
      </a>
    </div>
  </section>
</Base>

<style>
  .home-hero {
    border-bottom: 1px solid var(--border);
  }
  .home-hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 3rem;
    align-items: center;
    padding: 4rem 0;
  }
  .home-hero-text {
    max-width: 32rem;
  }
  .home-hero-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.04em;
    text-wrap: balance;
    color: var(--ink);
    margin: 0 0 1.1rem;
  }
  .home-hero-sub {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--ink-muted);
    max-width: 36ch;
    margin: 0 0 1.75rem;
  }
  .home-hero-cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .home-hero-figure {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }
  .home-hero-figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  @media (max-width: 820px) {
    .home-hero-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
      padding: 2.5rem 0 2rem;
    }
    .home-hero-figure {
      order: -1;
      aspect-ratio: 16 / 9;
    }
    .home-hero-text {
      max-width: none;
    }
  }

  .home-bento {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: 1.5fr 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    grid-template-areas:
      "sillas escritorios ambiente"
      "sillas accesorios  guias";
  }
  .home-bento-cell {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.35rem;
    min-height: 150px;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    transition: transform var(--dur-hover) var(--ease-out), border-color var(--dur-hover) var(--ease-out), box-shadow var(--dur-hover) var(--ease-out);
  }
  .home-bento-cell:hover {
    transform: translateY(-2px);
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
  }
  .home-bento-cell--escritorios,
  .home-bento-cell--accesorios {
    background: var(--surface-muted);
  }
  .home-bento-cell--guias {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }
  .home-bento-cell--guias .home-bento-icon,
  .home-bento-cell--guias .home-bento-count {
    color: var(--accent-ink);
  }
  .home-bento-cell--sillas {
    position: relative;
    overflow: hidden;
    min-height: 312px;
    color: #fff;
    border-color: transparent;
    background:
      linear-gradient(180deg, rgba(20, 24, 22, 0.08) 0%, rgba(20, 24, 22, 0.84) 100%),
      var(--surface-muted) url('/images/articulos/mejor-silla-ergonomica-calidad-precio.webp') center / cover no-repeat;
  }
  .home-bento-cell--sillas .home-bento-icon,
  .home-bento-cell--sillas .home-bento-count {
    color: #fff;
  }
  .home-bento-icon {
    color: var(--accent);
  }
  .home-bento-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }
  .home-bento-cell--sillas .home-bento-name {
    font-size: 1.5rem;
  }
  .home-bento-desc {
    font-size: 0.85rem;
    line-height: 1.4;
    opacity: 0.92;
    max-width: 32ch;
  }
  .home-bento-count {
    margin-top: 0.15rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--ink-muted);
  }
  @media (max-width: 760px) {
    .home-bento {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto;
      grid-template-areas:
        "sillas sillas"
        "escritorios accesorios"
        "ambiente guias";
    }
    .home-bento-cell--sillas {
      min-height: 220px;
    }
  }
  @media (max-width: 460px) {
    .home-bento {
      grid-template-columns: 1fr;
      grid-template-areas:
        "sillas"
        "escritorios"
        "accesorios"
        "ambiente"
        "guias";
    }
  }

  .home-inline-link {
    display: inline-block;
    margin-top: 0.25rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
    transition: color var(--dur-hover) var(--ease-out), transform var(--dur-press) var(--ease-out);
  }
  .home-inline-link:hover {
    color: var(--accent-hover);
  }
  .home-inline-link:active {
    transform: scale(0.98);
  }

  .home-index {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--border);
  }
  .home-index-item {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: var(--ink);
    transition: padding-left var(--dur-hover) var(--ease-out), color var(--dur-hover) var(--ease-out);
  }
  .home-index-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .home-index-meta {
    font-size: 0.78rem;
    color: var(--ink-muted);
  }
  .home-index-item:hover {
    padding-left: 0.5rem;
    color: var(--accent);
  }
  .home-index-item:hover .home-index-meta {
    color: var(--ink-muted);
  }
  @media (min-width: 761px) {
    .home-index-item:nth-child(odd) {
      padding-right: 2rem;
    }
    .home-index-item:nth-child(even) {
      padding-left: 2rem;
      border-left: 1px solid var(--border);
    }
    .home-index-item:nth-child(even):hover {
      padding-left: 2.5rem;
    }
  }
  @media (max-width: 760px) {
    .home-index {
      grid-template-columns: 1fr;
    }
  }

  .home-method-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  .home-method-lead {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    line-height: 1.65;
    color: var(--ink);
    max-width: 44ch;
    margin: 0 0 1.25rem;
    text-wrap: pretty;
  }
  .home-method-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }
  .home-method-list li {
    position: relative;
    padding-left: 1.5rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--ink-muted);
  }
  .home-method-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 7px;
    height: 7px;
    border-radius: var(--radius-full);
    background: var(--accent);
  }
  @media (max-width: 760px) {
    .home-method-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
