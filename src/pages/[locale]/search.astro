---
import Base from '@/layouts/Base.astro';
import CategoryIcon from '@/components/CategoryIcon.astro';
import { READY_LOCALES, type Locale } from '@/i18n/locales';
import { absoluteUrl, buildAlternates, localizedPath, pathLocaleSegment } from '@/i18n/routes';

export async function getStaticPaths() {
  return READY_LOCALES
    .filter(locale => locale !== 'es-ES')
    .map(locale => ({ params: { locale: pathLocaleSegment(locale) }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
const pagePath = localizedPath(locale, ['search']);
const alternates = buildAlternates({
  'es-ES': localizedPath('es-ES', ['buscar']),
  [locale]: pagePath,
});
---

<Base
  title="Search Home Office Guides | Tu Espacio de Trabajo"
  description="Search English home office guides, ergonomic chair comparisons and product database pages."
  canonical={absoluteUrl(pagePath)}
  alternates={alternates}
  locale={locale}
  noindex={true}
>
  <div class="container section">
    <h1 class="search-title">Search</h1>
    <p class="search-subtitle">Find English guides, comparisons and product pages for your home office.</p>

    <div class="search-box">
      <label for="search-input" class="sr-only">Search articles and products</label>
      <div class="search-input-wrap">
        <span class="search-icon" aria-hidden="true">🔍</span>
        <input type="search" id="search-input" placeholder="What are you looking for? Ergonomic chair, standing desk..." autocomplete="off" spellcheck="false" />
      </div>
      <div id="search-meta" class="search-meta search-meta--hidden"></div>
    </div>

    <div id="results-container">
      <div id="loading-state" class="search-state"><p class="text-muted">Loading search index...</p></div>
      <div id="empty-state" class="search-state search-state--hidden"><p class="search-state-icon">🖥️</p><p class="text-muted">Type something to search the English site.</p></div>
      <div id="no-results-state" class="search-state search-state--hidden">
        <p class="search-state-icon">🔍</p>
        <h2 class="search-state-heading">No results</h2>
        <p class="text-muted">Try another keyword or browse by category:</p>
        <div class="search-state-cats">
          <a href="/en/chairs/" class="affiliate-button search-cat-btn"><CategoryIcon categoria="sillas" size={14} /> Chairs</a>
          <a href="/en/desks/" class="affiliate-button search-cat-btn"><CategoryIcon categoria="escritorios" size={14} /> Desks</a>
          <a href="/en/accessories/" class="affiliate-button search-cat-btn"><CategoryIcon categoria="accesorios" size={14} /> Accessories</a>
          <a href="/en/workspace/" class="affiliate-button search-cat-btn"><CategoryIcon categoria="ambiente" size={14} /> Workspace</a>
        </div>
      </div>
      <div id="results-grid" class="articles-grid search-results--hidden" role="region" aria-live="polite" aria-label="Search results"></div>
    </div>
  </div>
</Base>

<style>
  .search-box { margin-bottom: 2.5rem; }
  .search-icon { position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); font-size: 1.1rem; pointer-events: none; }
  #search-input { width: 100%; padding: 0.85rem 1.25rem 0.85rem 3rem; font-family: var(--font-sans); font-size: 1rem; color: var(--ink); background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); outline: none; }
  #search-input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 15%, transparent); }
  .search-meta { margin-top: 0.5rem; font-size: 0.85rem; color: var(--ink-muted); }
  .search-state { text-align: center; padding: 4rem 1rem; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  .search-title { font-size: 2rem; font-weight: 800; margin-bottom: 0.5rem; }
  .search-subtitle { color: var(--ink-muted); margin-bottom: 2rem; }
  .search-input-wrap { position: relative; }
  .search-meta--hidden, .search-state--hidden, .search-results--hidden { display: none; }
  .search-state-icon { font-size: 3rem; margin-bottom: 0.75rem; }
  .search-state-heading { font-size: 1.1rem; margin-bottom: 0.5rem; }
  .search-state-cats { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; margin-top: 1rem; }
  .search-cat-btn { font-size: 0.85rem; padding: 0.5rem 1rem; }
  .search-error { color: var(--accent); }
</style>

<script>
  const CATEGORY_NAMES: Record<string, string> = {
    chairs: 'Chairs',
    desks: 'Desks',
    accessories: 'Accessories',
    workspace: 'Workspace',
    guides: 'Guides',
  };
  interface Article { titulo: string; descripcion: string; slug: string; categoria: string; tipo: string; imagen: string | null; tags: string[]; contenido: string; }
  interface Producto { entidad: string; slug: string; titulo: string; sub: string; tipo: string; url: string; }
  let allArticles: Article[] = [];
  let allProductos: Producto[] = [];
  const input = document.getElementById('search-input') as HTMLInputElement;
  const meta = document.getElementById('search-meta')!;
  const loadingState = document.getElementById('loading-state')!;
  const emptyState = document.getElementById('empty-state')!;
  const noResultsState = document.getElementById('no-results-state')!;
  const resultsGrid = document.getElementById('results-grid')!;
  const normalize = (str: string) => str.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
  const escapeHtml = (str: string) => str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  function highlight(text: string, query: string): string {
    if (!query) return escapeHtml(text);
    const normText = normalize(text);
    const normQuery = normalize(query);
    const idx = normText.indexOf(normQuery);
    if (idx === -1) return escapeHtml(text);
    return escapeHtml(text.slice(0, idx)) + '<mark>' + escapeHtml(text.slice(idx, idx + query.length)) + '</mark>' + escapeHtml(text.slice(idx + query.length));
  }
  function renderCard(article: Article, query: string): string {
    const url = article.tipo === 'informativo' ? `/en/guides/${encodeURI(article.slug)}/` : `/en/${encodeURI(article.categoria)}/${encodeURI(article.slug)}/`;
    const catNombre = article.tipo === 'informativo' ? 'Guides' : (CATEGORY_NAMES[article.categoria] || escapeHtml(article.categoria));
    return `<article class="article-card"><div class="article-card-body"><div class="article-card-badges"><span class="article-card-category badge">${catNombre}</span></div><a href="${url}"><h3 class="article-card-title">${highlight(article.titulo, query)}</h3></a><p class="article-card-excerpt">${highlight(article.descripcion, query)}</p><div class="article-card-meta"><a href="${url}" class="article-card-link">Read more →</a></div></div></article>`;
  }
  function renderProductoCard(p: Producto, query: string): string {
    return `<article class="article-card"><div class="article-card-body"><div class="article-card-badges"><span class="article-card-category badge">Product</span></div><a href="${escapeHtml(p.url)}"><h3 class="article-card-title">${highlight(p.titulo, query)}</h3></a><p class="article-card-excerpt">${highlight(p.sub, query)}</p><div class="article-card-meta"><a href="${escapeHtml(p.url)}" class="article-card-link">View product →</a></div></div></article>`;
  }
  function search(query: string) {
    const q = query.trim();
    if (!q) {
      loadingState.style.display = 'none';
      emptyState.classList.remove('search-state--hidden');
      noResultsState.classList.add('search-state--hidden');
      resultsGrid.classList.add('search-results--hidden');
      meta.classList.add('search-meta--hidden');
      return;
    }
    const normQ = normalize(q);
    const results = allArticles.filter(a => normalize(`${a.titulo} ${a.descripcion} ${a.contenido} ${a.tags.join(' ')}`).includes(normQ));
    const productResults = allProductos.filter(p => normalize(`${p.titulo} ${p.sub}`).includes(normQ));
    const total = results.length + productResults.length;
    loadingState.style.display = 'none';
    emptyState.classList.add('search-state--hidden');
    if (total === 0) {
      noResultsState.classList.remove('search-state--hidden');
      resultsGrid.classList.add('search-results--hidden');
      meta.classList.add('search-meta--hidden');
    } else {
      noResultsState.classList.add('search-state--hidden');
      resultsGrid.innerHTML = productResults.map(p => renderProductoCard(p, q)).join('') + results.map(a => renderCard(a, q)).join('');
      resultsGrid.classList.remove('search-results--hidden');
      meta.textContent = `${total} ${total === 1 ? 'result' : 'results'} for "${q}"`;
      meta.classList.remove('search-meta--hidden');
    }
  }
  const urlQuery = new URLSearchParams(window.location.search).get('q');
  if (urlQuery) input.value = urlQuery;
  fetch('/en/search-index.json').then(r => r.json()).then((data: Producto[]) => { allProductos = data.filter(e => e.entidad === 'producto'); if (input.value.trim()) search(input.value); }).catch(() => {});
  fetch('/en/search.json').then(r => r.json()).then((data: Article[]) => { allArticles = data; loadingState.style.display = 'none'; emptyState.classList.remove('search-state--hidden'); if (input.value.trim()) search(input.value); }).catch(() => { loadingState.innerHTML = '<p class="search-error" role="alert">Error loading the search index. Reload the page.</p>'; });
  let debounceTimer: ReturnType<typeof setTimeout>;
  input.addEventListener('input', () => { clearTimeout(debounceTimer); debounceTimer = setTimeout(() => search(input.value), 200); });
  if (urlQuery) input.focus();
</script>
