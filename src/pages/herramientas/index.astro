---
import Base from '@/layouts/Base.astro';
import { buildAlternates, localizedPath } from '@/i18n/routes';

const siteUrl = 'https://tuespaciodetrabajo.com';
const pageUrl = `${siteUrl}/herramientas/`;
const alternates = buildAlternates({
  'es-ES': localizedPath('es-ES', ['herramientas']),
  en: localizedPath('en', ['tools']),
});

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Herramientas', item: pageUrl },
  ],
};
---

<Base
  title="Herramientas para home office | Tu Espacio de Trabajo"
  description="Calculadoras y utilidades gratis para montar tu home office: calcula alturas ergonómicas, compara productos y más."
  canonical={pageUrl}
  alternates={alternates}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />

  <main class="container section">
    <nav class="breadcrumb" aria-label="Migas de pan"><a href={localizedPath('es-ES')}>Inicio</a> › <span>Herramientas</span></nav>
    <h1>Herramientas</h1>
    <div class="tool-grid">
      <a class="tool-card" href={localizedPath('es-ES', ['herramientas', 'calculadora-ergonomia'])}>
        <h2>Calculadora de ergonomía</h2>
        <p>Calcula los rangos de altura de silla, escritorio y monitor para trabajar con una postura más saludable.</p>
      </a>
      <a class="tool-card" href={localizedPath('es-ES', ['herramientas', 'selector'])}>
        <h2>Recomendador de sillas y escritorios</h2>
        <p>Responde unas preguntas y encuentra las sillas o escritorios que mejor encajan con tu cuerpo, espacio y presupuesto.</p>
      </a>
    </div>
  </main>
</Base>

<style>
  .tool-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; }
  .tool-card { display: block; padding: 1.25rem; border: 1px solid var(--border); border-radius: var(--radius); text-decoration: none; color: inherit; background: var(--surface); }
  .tool-card p { color: var(--ink-muted); }
</style>
