---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import LanguageSuggestion from '@/components/LanguageSuggestion.astro';
import { DEFAULT_LOCALE, LOCALES, type Locale } from '@/i18n/locales';
import { t } from '@/i18n/ui';
import { localizedPath, type AlternateLink } from '@/i18n/routes';
import globalStyles from '@/styles/global.css?inline';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  alternates?: AlternateLink[];
  locale?: Locale;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  robots?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  image,
  canonical,
  alternates = [],
  locale = DEFAULT_LOCALE,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  robots,
  noindex = false,
} = Astro.props;
const robotsContent = robots ?? (noindex ? 'noindex, follow, max-image-preview:large' : 'max-image-preview:large');
const localeConfig = LOCALES[locale];
const ui = t(locale);

const siteUrl = 'https://tuespaciodetrabajo.com';
const ogImage = image ? `${siteUrl}${image}` : `${siteUrl}/og-default.jpg`;
const canonicalUrl = canonical || Astro.url.href;
const currentPath = Astro.url.pathname;
const alternateLinks = alternates.length > 0
  ? alternates
  : [
      { hreflang: localeConfig.hreflang, href: canonicalUrl },
      { hreflang: 'x-default', href: canonicalUrl },
    ];
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: ui.siteName,
  url: siteUrl,
  description,
  inLanguage: localeConfig.hreflang,
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${siteUrl}${localizedPath(locale, [locale === DEFAULT_LOCALE ? 'buscar' : 'search']).replace(/\/$/, '/') }?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};

const bottomNavItems = locale === DEFAULT_LOCALE
  ? [
      {
        href: localizedPath(locale),
        active: currentPath === localizedPath(locale),
        label: ui.article.home,
        icon: 'home',
      },
      {
        href: localizedPath(locale, ['sillas']),
        active: currentPath.startsWith(localizedPath(locale, ['sillas'])),
        label: ui.categories.sillas,
        icon: 'chair',
      },
      {
        href: localizedPath(locale, ['escritorios']),
        active: currentPath.startsWith(localizedPath(locale, ['escritorios'])),
        label: ui.categories.escritorios,
        icon: 'desk',
      },
      {
        href: localizedPath(locale, [localeConfig.guideSegment]),
        active: currentPath.startsWith(localizedPath(locale, [localeConfig.guideSegment])),
        label: ui.article.guides,
        icon: 'guide',
      },
      {
        href: localizedPath(locale, ['buscar']),
        active: currentPath.startsWith(localizedPath(locale, ['buscar']).replace(/\/$/, '')),
        label: ui.nav.search,
        icon: 'search',
      },
    ]
  : [
      {
        href: localizedPath(locale),
        active: currentPath === localizedPath(locale),
        label: ui.article.home,
        icon: 'home',
      },
      {
        href: localizedPath(locale, ['catalog']),
        active: currentPath.startsWith(localizedPath(locale, ['catalog'])),
        label: ui.nav.catalog,
        icon: 'chair',
      },
      {
        href: localizedPath(locale, ['guides']),
        active: currentPath.startsWith(localizedPath(locale, ['guides'])),
        label: ui.article.guides,
        icon: 'guide',
      },
      {
        href: localizedPath(locale, ['search']),
        active: currentPath.startsWith(localizedPath(locale, ['search'])),
        label: ui.nav.search,
        icon: 'search',
      },
    ];

const cookiePolicyPath = locale === DEFAULT_LOCALE
  ? localizedPath(DEFAULT_LOCALE, ['cookies'])
  : localizedPath(locale, ['cookies']);
const bottomNavLabel = locale === DEFAULT_LOCALE ? 'Navegación inferior' : 'Bottom navigation';
---

<!doctype html>
<html lang={localeConfig.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#fafafa" id="meta-theme-color" />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content={robotsContent} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Preload critical self-hosted fonts -->
    <link rel="preload" href="/fonts/schibsted-grotesk-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-serif-4-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Preconnect for resources loaded on article pages -->
    <link rel="preconnect" href="https://m.media-amazon.com" crossorigin />
    <link rel="dns-prefetch" href="https://m.media-amazon.com" />

    <!-- DNS prefetch for external resources -->
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.google-analytics.com" />
    <link rel="dns-prefetch" href="https://static.cloudflareinsights.com" />
    <link rel="dns-prefetch" href="https://www.clarity.ms" />
    <link rel="dns-prefetch" href="https://www.amazon.es" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {locale === DEFAULT_LOCALE && <link rel="alternate" type="application/rss+xml" title="Tu Espacio de Trabajo" href="/rss.xml" />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="800" />
    <meta property="og:image:height" content="533" />
    <meta property="og:locale" content={localeConfig.ogLocale} />
    <meta property="og:site_name" content={ui.siteName} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {alternateLinks.map((link) => (
      <link rel="alternate" hreflang={link.hreflang} href={link.href} />
    ))}

    <style set:html={globalStyles}></style>

    <!-- Dark mode: apply saved preference before paint -->
    <script is:inline>
      (function() {
        var t = localStorage.getItem('theme');
        if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme:dark)').matches)) {
          document.documentElement.setAttribute('data-theme', 'dark');
          var m = document.getElementById('meta-theme-color');
          if (m) m.content = '#131514';
        }
      })();
    </script>

    <!-- Schema.org -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">{ui.skipToContent}</a>
    <Header locale={locale} alternates={alternateLinks} />
    <LanguageSuggestion locale={locale} alternates={alternateLinks} />
    <main id="main-content">
      <slot />
    </main>
    <Footer locale={locale} />

    <!-- Mobile bottom navigation -->
    <nav class="bottom-nav" aria-label={bottomNavLabel}>
      {bottomNavItems.map(item => (
        <a href={item.href} class={`bottom-nav-item ${item.active ? 'bottom-nav-active' : ''}`}>
          {item.icon === 'home' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l-2 0l9 -9l9 9l-2 0"/><path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-7"/><path d="M9 21v-6a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v6"/></svg>
          )}
          {item.icon === 'chair' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11a2 2 0 0 1 2 -2h10a2 2 0 0 1 2 2v4a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2z"/><path d="M5 15v4"/><path d="M19 15v4"/><path d="M9 11v-4a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v4"/></svg>
          )}
          {item.icon === 'desk' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="4" rx="1"/><path d="M4 11v8"/><path d="M20 11v8"/><path d="M12 11v4"/></svg>
          )}
          {item.icon === 'guide' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 19a9 9 0 0 1 9 0a9 9 0 0 1 9 0"/><path d="M3 6a9 9 0 0 1 9 0a9 9 0 0 1 9 0"/><path d="M3 6l0 13"/><path d="M12 6l0 13"/><path d="M21 6l0 13"/></svg>
          )}
          {item.icon === 'search' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0"/><path d="M21 21l-6 -6"/></svg>
          )}
          <span>{item.label}</span>
        </a>
      ))}
    </nav>

    <!-- Scroll reveal observer -->
    <script is:inline>
      (function() {
        var els = document.querySelectorAll('.reveal, .reveal-group');
        if (!els.length || !('IntersectionObserver' in window)) {
          els.forEach(function(el) { el.classList.add('revealed'); });
          return;
        }
        var obs = new IntersectionObserver(function(entries) {
          entries.forEach(function(e) {
            if (e.isIntersecting) {
              e.target.classList.add('revealed');
              obs.unobserve(e.target);
            }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
        els.forEach(function(el) { obs.observe(el); });
      })();
    </script>

    <!-- Reveal-on-scroll editorial (data-reveal), Fase 1 -->
    <script>
      import { initReveal } from '@/scripts/reveal';
      const w = window as unknown as { __revealInit?: boolean };
      if (!w.__revealInit) {
        w.__revealInit = true;
        initReveal();
      }
    </script>

    <!-- Microsoft Clarity: load only after cookie consent -->
    <script is:inline>
      (function() {
        function loadClarity() {
          if (window.clarity) return;
          (function(c,l,a,r,i,t,y){
            c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
            t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
            y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
          })(window, document, "clarity", "script", "wixf0kjv4e");
        }

        var consent = localStorage.getItem('cookie-consent');
        if (consent === 'accepted') {
          window.addEventListener('load', function() { setTimeout(loadClarity, 2000); });
        }

        window.addEventListener('cookie-consent-accepted', function() {
          loadClarity();
        });
      })();
    </script>

    <!-- GA4: load only after cookie consent -->
    <script is:inline>
      (function() {
        function loadGA() {
          if (document.querySelector('script[src*="googletagmanager"]')) return;
          var s = document.createElement('script');
          s.src = 'https://www.googletagmanager.com/gtag/js?id=G-SBW6V0SBW0';
          s.async = true;
          document.head.appendChild(s);
          s.onload = function() {
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            window.gtag = gtag;
            gtag('js', new Date());
            gtag('config', 'G-SBW6V0SBW0');
          };
        }

        // Check existing consent
        var consent = localStorage.getItem('cookie-consent');
        if (consent === 'accepted') {
          window.addEventListener('load', function() { setTimeout(loadGA, 2000); });
        }

        // Listen for consent events
        window.addEventListener('cookie-consent-accepted', function() {
          loadGA();
        });

        // Track affiliate clicks (works even without GA)
        document.addEventListener('click', function(e) {
          var link = e.target.closest('a[rel*="sponsored"]');
          if (!link) return;
          var href = link.href || '';
          var tienda = 'otro';
          if (href.includes('amazon.')) tienda = 'amazon';
          if (typeof gtag === 'function') {
            gtag('event', 'affiliate_click', {
              event_category: 'affiliate',
              event_label: tienda,
              link_url: href,
              page_path: window.location.pathname
            });
          }
        });
      })();
    </script>

    <!-- Cookie consent banner (RGPD) -->
    <div id="cookie-banner" class="cookie-banner" role="dialog" aria-label={ui.cookies.label} style="display:none;">
      <div class="cookie-banner-inner">
        <p>{ui.cookies.text} <a href={cookiePolicyPath}>{ui.cookies.policy}</a>.</p>
        <div class="cookie-banner-actions">
          <button id="cookie-accept" class="cookie-btn cookie-btn-accept">{ui.cookies.accept}</button>
          <button id="cookie-reject" class="cookie-btn cookie-btn-reject">{ui.cookies.reject}</button>
        </div>
      </div>
    </div>
    <script is:inline>
      (function() {
        var consent = localStorage.getItem('cookie-consent');
        if (consent) return; // Already decided
        var banner = document.getElementById('cookie-banner');
        if (!banner) return;
        banner.style.display = '';
        document.getElementById('cookie-accept')?.addEventListener('click', function() {
          localStorage.setItem('cookie-consent', 'accepted');
          banner.style.display = 'none';
          window.dispatchEvent(new Event('cookie-consent-accepted'));
        });
        document.getElementById('cookie-reject')?.addEventListener('click', function() {
          localStorage.setItem('cookie-consent', 'rejected');
          banner.style.display = 'none';
        });
      })();
    </script>
    <style>
      .cookie-banner {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 200;
        background: var(--surface);
        border-top: 1px solid var(--border);
        box-shadow: 0 -4px 20px rgba(0,0,0,0.1);
        padding: 1rem 1.5rem;
      }
      .cookie-banner-inner {
        max-width: 1140px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .cookie-banner-inner p {
        flex: 1;
        min-width: 200px;
        font-size: 0.85rem;
        color: var(--ink-muted);
        margin: 0;
      }
      .cookie-banner-inner a {
        color: var(--accent);
        text-decoration: underline;
      }
      .cookie-banner-actions {
        display: flex;
        gap: 0.5rem;
      }
      .cookie-btn {
        font-family: var(--font-sans);
        font-size: 0.8rem;
        font-weight: 600;
        padding: 0.5rem 1.25rem;
        border-radius: var(--radius);
        cursor: pointer;
        border: none;
      }
      .cookie-btn-accept {
        background: var(--accent);
        color: #fff;
        border-radius: var(--radius);
      }
      .cookie-btn-reject {
        background: transparent;
        color: var(--ink-muted);
        border: 1px solid var(--border);
        border-radius: var(--radius);
      }
      @media (max-width: 480px) {
        .cookie-banner { bottom: calc(56px + env(safe-area-inset-bottom, 0px)); }
        .cookie-banner-inner { flex-direction: column; text-align: center; }
        .cookie-banner-actions { width: 100%; }
        .cookie-btn { flex: 1; }
      }
    </style>
  </body>
</html>
