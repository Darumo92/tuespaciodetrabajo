---
import Base from './Base.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import CategoryIcon from '@/components/CategoryIcon.astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { DEFAULT_LOCALE, LOCALES, type Locale } from '@/i18n/locales';
import { articlePath, absoluteUrl, localizedPath, type AlternateLink } from '@/i18n/routes';
import { t } from '@/i18n/ui';

interface Props {
  articulo: CollectionEntry<'articulos'> | CollectionEntry<'articulosI18n'>;
  locale?: Locale;
  canonical?: string;
  alternates?: AlternateLink[];
}

const { articulo, locale = DEFAULT_LOCALE, canonical, alternates = [] } = Astro.props;
const ui = t(locale);
const { titulo, descripcion, categoria, fecha, actualizadoEn, tags, imagen, imagenAlt, faqs, tipo } = articulo.data;
const categoriaSlug = 'categoriaSlug' in articulo.data ? articulo.data.categoriaSlug : categoria;
const slug = 'translationOf' in articulo.data ? articulo.data.localizedSlug : articulo.slug;
const esInformativo = tipo === 'informativo';
const autor = articulo.data.autor || 'Tu Espacio de Trabajo';

// Reading time: ~200 words per minute, strip MDX syntax first
const wordCount = articulo.body
  .replace(/^---[\s\S]*?---/, '')
  .replace(/^import\s.+$/gm, '')
  .replace(/<[^>]+>/g, ' ')
  .replace(/[#*`_~\[\]()]/g, '')
  .trim()
  .split(/\s+/).length;
const minutosLectura = Math.max(1, Math.round(wordCount / 200));

// Related articles: prioritize shared tags, then same category
const allArticles = locale === DEFAULT_LOCALE
  ? await getCollection('articulos', ({ slug }) => slug !== articulo.slug)
  : await getCollection('articulosI18n', ({ data }) => data.locale === locale && data.localizedSlug !== slug);
const articleTags = new Set(tags || []);

const scored = allArticles.map(a => {
  let score = 0;
  // Same tipo: +2
  if (a.data.tipo === tipo) score += 2;
  // Same category: +3
  if (a.data.categoria === categoria) score += 3;
  // Shared tags: +1 per tag
  (a.data.tags || []).forEach(t => { if (articleTags.has(t)) score += 1; });
  return { article: a, score };
});

const related = scored
  .filter(s => s.score > 0)
  .sort((a, b) => b.score - a.score || b.article.data.fecha.getTime() - a.article.data.fecha.getTime())
  .slice(0, 3)
  .map(s => s.article);

const categoriasInfo: Record<string, { nombre: string }> = {
  sillas: { nombre: ui.categories.sillas },
  chairs: { nombre: ui.categories.sillas },
  escritorios: { nombre: ui.categories.escritorios },
  desks: { nombre: ui.categories.escritorios },
  accesorios: { nombre: ui.categories.accesorios },
  accessories: { nombre: ui.categories.accesorios },
  ambiente: { nombre: ui.categories.ambiente },
  workspace: { nombre: ui.categories.ambiente },
  'audio-video': { nombre: ui.categories['audio-video'] },
};

const catInfo = esInformativo
  ? { nombre: ui.article.guides }
  : categoriasInfo[categoriaSlug];

const fechaFormateada = fecha.toLocaleDateString(LOCALES[locale].htmlLang, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const actualizadoFormateado = actualizadoEn?.toLocaleDateString(LOCALES[locale].htmlLang, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const siteUrl = 'https://tuespaciodetrabajo.com';

const articleUrl = absoluteUrl(articlePath({
  locale,
  tipo: tipo ?? 'comparativa',
  categoriaSlug,
  slug,
}));

const homePath = articlePath({ locale, tipo: 'informativo', categoriaSlug: '', slug: '' }).replace(/\/(?:guias|guides)\/$/, '/');
const categoryPath = articlePath({
  locale,
  tipo: esInformativo ? 'informativo' : 'comparativa',
  categoriaSlug,
  slug: '',
});

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: titulo,
  description: descripcion,
  ...(imagen && { image: `${siteUrl}${imagen}` }),
  datePublished: fecha.toISOString(),
  dateModified: (actualizadoEn || fecha).toISOString(),
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': articleUrl,
  },
  wordCount: wordCount,
  inLanguage: LOCALES[locale].hreflang,
  ...(tags && tags.length > 0 && { keywords: tags.join(', ') }),
  author: {
    '@type': 'Person',
    name: autor,
    url: locale === DEFAULT_LOCALE ? `${siteUrl}/sobre-mi/` : `${siteUrl}${localizedPath(locale, ['about'])}`,
    sameAs: ['https://www.linkedin.com/in/david-rubio-mota/'],
  },
  publisher: {
    '@type': 'Organization',
    name: ui.siteName,
    url: siteUrl,
    logo: {
      '@type': 'ImageObject',
      url: `${siteUrl}/favicon.svg`,
    },
  },
  isPartOf: {
    '@type': 'WebSite',
    name: ui.siteName,
    url: siteUrl,
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: ui.article.home, item: absoluteUrl(homePath) },
    { '@type': 'ListItem', position: 2, name: catInfo.nombre, item: absoluteUrl(categoryPath) },
    { '@type': 'ListItem', position: 3, name: titulo, item: articleUrl },
  ],
};
---

<Base title={titulo} description={descripcion} image={imagen} canonical={canonical || articleUrl} alternates={alternates} locale={locale} ogType="article" publishedTime={fecha.toISOString()} modifiedTime={(actualizadoEn || fecha).toISOString()}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  {imagen && <link rel="preload" as="image" href={imagen} slot="head" />}

  <div class="reading-progress" id="reading-progress" aria-hidden="true">
    <div class="reading-progress-bar" id="reading-progress-bar"></div>
  </div>

  <article class="article-page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={homePath}>{ui.article.home}</a>
      <span class="breadcrumb-sep" aria-hidden="true">></span>
      <a href={categoryPath}>{catInfo.nombre}</a>
      <span class="breadcrumb-sep" aria-hidden="true">></span>
      <span>{titulo}</span>
    </nav>

    <header class="article-header">
      <span class="article-category-badge">
        <CategoryIcon categoria={esInformativo ? 'guias' : categoriaSlug} size={16} /> {catInfo.nombre}
      </span>

      <h1 class="article-title">{titulo}</h1>
      <p class="article-description">{descripcion}</p>

      <div class="article-meta">
        <span class="article-author">{ui.article.by} <a href={locale === DEFAULT_LOCALE ? '/sobre-mi/' : localizedPath(locale, ['about'])} rel="author">{autor}</a></span>
        <time datetime={fecha.toISOString().split('T')[0]}>{ui.article.published}: {fechaFormateada}</time>
        {actualizadoFormateado && (
          <time datetime={(actualizadoEn as Date).toISOString().split('T')[0]} class="article-updated">
            {ui.article.updated}: {actualizadoFormateado}
          </time>
        )}
        <span>{minutosLectura} {ui.article.minRead}</span>
      </div>
    </header>

    {imagen && (
      <img
        src={imagen}
        alt={imagenAlt || titulo}
        width="800"
        height="400"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        sizes="(max-width: 768px) 100vw, 800px"
        class="article-hero-img"
      />
    )}

    <p class="trust-line">
      {ui.article.trustLine}
    </p>

    {!esInformativo && (
      <div class="affiliate-disclaimer" role="note">
        <span aria-hidden="true">i</span>
        <span>
          {ui.article.affiliateDisclosure}
        </span>
      </div>
    )}

    <nav class="toc" id="toc" aria-label={ui.article.toc} style="display:none;">
      <p class="toc-title">{ui.article.toc}</p>
      <ol class="toc-list" id="toc-list"></ol>
    </nav>

    <div class="prose" id="article-content">
      <slot />
    </div>

    {tags && tags.length > 0 && (
      <div class="article-tags-section">
        <strong class="article-tags-label">{ui.article.tags}:</strong>
        <div class="article-tags-list">
          {tags.map(tag => (
            <span class="badge article-tag-badge">{tag}</span>
          ))}
        </div>
      </div>
    )}

    {faqs && faqs.length > 0 && (
      <section class="faq-section" aria-labelledby="faq-titulo">
        <div class="faq-header">
          <h2 id="faq-titulo">{ui.article.faqTitle}</h2>
          <p class="faq-subtitle">
            {locale === 'en'
              ? `${faqs.length} questions about ${titulo.toLowerCase()}`
              : `${faqs.length} preguntas sobre ${titulo.toLowerCase().includes('mejor') ? titulo.replace(/^mejor\w*\s*/i, '') : titulo.toLowerCase()}`}
          </p>
        </div>
        <div class="faq-list">
          {faqs.map((f, i) => (
            <details class="faq-item" {...(i === 0 ? { open: true } : {})}>
              <summary class="faq-pregunta">
                <span class="faq-pregunta-text">{f.pregunta}</span>
                <span class="faq-toggle" aria-hidden="true"></span>
              </summary>
              <div class="faq-respuesta">{f.respuesta}</div>
            </details>
          ))}
        </div>
      </section>
    )}

    {related.length > 0 && (
      <section class="article-related-section">
        <h2 class="article-related-title">
          {ui.article.related}
        </h2>
        <div class="articles-grid">
          {related.map(a => (
            <ArticleCard articulo={a} locale={locale} />
          ))}
        </div>
        <div class="article-related-more">
          <a href={categoryPath} class="affiliate-button article-related-btn">
            {ui.article.seeMoreIn} {catInfo.nombre} →
          </a>
        </div>
      </section>
    )}

    <div class="back-to-top-wrap">
      <a href="#main-content" class="back-to-top-link">↑ {ui.article.backToTop}</a>
    </div>
  </article>

  {!esInformativo && (
    <div class="sticky-cta-bar" id="sticky-cta" aria-hidden="true">
      <div class="sticky-cta-inner">
        <span class="sticky-cta-name" id="sticky-cta-name"></span>
        <span class="sticky-cta-price" id="sticky-cta-price"></span>
        <a class="sticky-cta-btn" id="sticky-cta-link" href="#article-content">
          {ui.commerce.viewPrice} →
        </a>
      </div>
    </div>
  )}

  <script>
    // Reading progress bar
    (function() {
      const bar = document.getElementById('reading-progress-bar');
      const article = document.querySelector('.article-page');
      if (!bar || !article) return;
      window.addEventListener('scroll', () => {
        const rect = article.getBoundingClientRect();
        const total = article.scrollHeight - window.innerHeight;
        const scrolled = -rect.top;
        const pct = Math.min(100, Math.max(0, (scrolled / total) * 100));
        bar.style.width = pct + '%';
      }, { passive: true });
    })();

    // TOC active section tracking
    (function() {
      const tocLinks = document.querySelectorAll('.toc-list a');
      if (tocLinks.length < 3) return;
      const headings = Array.from(tocLinks).map(a => {
        const id = a.getAttribute('href')?.slice(1);
        return id ? document.getElementById(id) : null;
      }).filter(Boolean) as HTMLElement[];

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach(entry => {
            const id = entry.target.id;
            const link = document.querySelector(`.toc-list a[href="#${id}"]`);
            if (link) link.classList.toggle('toc-active', entry.isIntersecting);
          });
        },
        { rootMargin: '-80px 0px -60% 0px', threshold: 0 }
      );
      headings.forEach(h => observer.observe(h));
    })();

    // Sticky CTA bar for mobile
    (function() {
      const stickyBar = document.getElementById('sticky-cta');
      if (!stickyBar) return;

      const nameEl = document.getElementById('sticky-cta-name');
      const priceEl = document.getElementById('sticky-cta-price');
      const linkEl = document.getElementById('sticky-cta-link') as HTMLAnchorElement;
      if (!nameEl || !priceEl || !linkEl) return;

      const topPick = document.querySelector('.top-pick');
      if (!topPick) return;

      const name = topPick.querySelector('.top-pick-nombre')?.textContent || '';
      const price = topPick.querySelector('.top-pick-precio')?.textContent || '';
      const firstLink = topPick.querySelector('.affiliate-button') as HTMLAnchorElement;
      if (!firstLink) return;

      nameEl.textContent = name.length > 30 ? name.slice(0, 30) + '...' : name;
      priceEl.textContent = price;
      linkEl.href = firstLink.href;
      linkEl.target = '_blank';
      linkEl.rel = 'nofollow noopener noreferrer sponsored';

      const observer = new IntersectionObserver(
        ([entry]) => {
          if (window.innerWidth <= 768) {
            stickyBar.classList.toggle('sticky-cta-visible', !entry.isIntersecting);
            stickyBar.setAttribute('aria-hidden', String(entry.isIntersecting));
          }
        },
        { threshold: 0 }
      );
      observer.observe(topPick);

      // Hide on scroll to bottom (footer area)
      window.addEventListener('scroll', () => {
        const nearBottom = window.innerHeight + window.scrollY >= document.body.offsetHeight - 200;
        if (nearBottom) {
          stickyBar.classList.remove('sticky-cta-visible');
        }
      }, { passive: true });
    })();

    // Wrap tables for horizontal scroll on mobile
    document.querySelectorAll('.prose table').forEach(table => {
      if (!table.parentElement?.classList.contains('table-wrapper')) {
        const wrapper = document.createElement('div');
        wrapper.className = 'table-wrapper';
        table.parentNode?.insertBefore(wrapper, table);
        wrapper.appendChild(table);
      }
    });

    const content = document.getElementById('article-content');
    const tocNav = document.getElementById('toc');
    const tocList = document.getElementById('toc-list');
    if (content && tocNav && tocList) {
      const headings = content.querySelectorAll('h2');
      if (headings.length >= 3) {
        headings.forEach((h, i) => {
          if (!h.id) h.id = `section-${i}`;
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = `#${h.id}`;
          a.textContent = h.textContent;
          li.appendChild(a);
          tocList.appendChild(li);
        });
        tocNav.style.display = '';
      }
    }
  </script>

  <style>
    /* Reading progress bar */
    .reading-progress {
      position: fixed;
      top: 60px;
      left: 0;
      right: 0;
      height: 2px;
      z-index: 99;
      background: transparent;
    }
    .reading-progress-bar {
      height: 100%;
      width: 0;
      background: var(--accent);
      transition: width 0.1s linear;
    }

    .toc {
      background: var(--surface-muted);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.25rem 1.5rem;
      margin-bottom: 2rem;
    }
    .toc-title {
      font-family: var(--font-display);
      font-size: 0.88rem;
      font-weight: 700;
      letter-spacing: -0.01em;
      margin-bottom: 0.75rem;
      color: var(--ink);
    }
    .toc-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      counter-reset: toc-counter;
    }
    .toc-list li {
      padding-left: 0;
    }
    .toc-list li::before {
      content: counter(toc-counter) ". ";
      counter-increment: toc-counter;
      font-weight: 600;
      color: var(--ink-muted);
      font-size: 0.85rem;
    }
    .toc-list a {
      color: var(--ink-muted);
      text-decoration: none;
      font-size: 0.88rem;
      line-height: 1.5;
      transition: color var(--dur-hover) var(--ease-out), background var(--dur-hover) var(--ease-out);
      padding: 0.15rem 0.4rem;
      border-radius: 4px;
    }
    .toc-list a:hover {
      color: var(--accent);
      background: color-mix(in srgb, var(--accent) 6%, transparent);
    }
    .toc-list a.toc-active {
      color: var(--accent);
      font-weight: 600;
      background: color-mix(in srgb, var(--accent) 8%, transparent);
    }

    /* Trust line (editorial, sin iconos decorativos) */
    .trust-line {
      margin: 1.25rem 0;
      font-size: 0.85rem;
      line-height: 1.6;
      color: var(--ink-muted);
    }

    .article-author a {
      color: var(--accent);
      text-decoration: none;
      font-weight: 600;
    }
    .article-author a:hover {
      text-decoration: underline;
    }

    .back-to-top-wrap {
      text-align: center;
      margin-top: 2.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--border);
    }
    .back-to-top-link {
      display: inline-block;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--accent);
      text-decoration: none;
      padding: 0.5rem 1.25rem;
      border: 1.5px solid var(--accent);
      border-radius: 99px;
      transition: color var(--dur-hover) var(--ease-out), background var(--dur-hover) var(--ease-out);
    }
    .back-to-top-link:hover {
      background: var(--accent);
      color: white;
    }

    .article-updated {
      color: var(--accent);
      font-weight: 600;
    }

    /* Sticky CTA bar (mobile only) */
    .sticky-cta-bar {
      display: none;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 90;
      background: var(--surface);
      border-top: 1px solid var(--border);
      box-shadow: var(--shadow-md);
      padding: 0.625rem 1rem;
      transform: translateY(100%);
      transition: transform var(--dur-hover) var(--ease-out);
    }
    .sticky-cta-bar.sticky-cta-visible {
      transform: translateY(0);
    }
    .sticky-cta-inner {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      max-width: 800px;
      margin: 0 auto;
    }
    .sticky-cta-name {
      font-family: var(--font-display);
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: -0.01em;
      color: var(--ink);
      flex: 1;
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .sticky-cta-price {
      font-family: var(--font-display);
      font-size: 0.9rem;
      font-weight: 700;
      font-variant-numeric: tabular-nums;
      color: var(--accent);
      white-space: nowrap;
    }
    .sticky-cta-btn {
      background: var(--accent);
      color: #fff;
      font-size: 0.8rem;
      font-weight: 700;
      padding: 0.5rem 1rem;
      border-radius: var(--radius);
      text-decoration: none;
      white-space: nowrap;
      transition: background var(--dur-hover) var(--ease-out);
    }
    .sticky-cta-btn:hover {
      background: var(--accent-hover);
      color: #fff;
    }
    @media (max-width: 768px) {
      .sticky-cta-bar {
        display: block;
        bottom: calc(56px + env(safe-area-inset-bottom, 0px));
      }
    }

    /* FAQ */
    .faq-section {
      margin-top: 2.5rem;
      padding-top: 2rem;
      border-top: 2px solid var(--border);
    }
    .faq-header {
      margin-bottom: 1.25rem;
    }
    .faq-section h2 {
      font-family: var(--font-display);
      font-size: 1.3rem;
      font-weight: 700;
      margin-bottom: 0.25rem;
    }
    .faq-subtitle {
      font-size: 0.85rem;
      color: var(--ink-muted);
    }
    .faq-list {
      display: flex;
      flex-direction: column;
    }
    .faq-item {
      border: 1px solid var(--border);
      border-radius: var(--radius);
      margin-bottom: 0.5rem;
      overflow: hidden;
      transition: border-color 0.2s;
    }
    .faq-item[open] {
      border-color: color-mix(in srgb, var(--accent) 25%, var(--border));
    }
    .faq-pregunta {
      background: var(--surface);
      padding: 1rem 1.25rem;
      font-weight: 600;
      font-size: 0.92rem;
      cursor: pointer;
      list-style: none;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      user-select: none;
      transition: background 0.2s;
    }
    .faq-pregunta:hover {
      background: var(--surface-muted);
    }
    .faq-pregunta::-webkit-details-marker {
      display: none;
    }
    .faq-pregunta-text {
      flex: 1;
    }
    .faq-toggle {
      width: 24px;
      height: 24px;
      border-radius: var(--radius-sm);
      background: var(--surface-muted);
      flex-shrink: 0;
      position: relative;
      transition: transform 0.3s ease, background 0.2s, color 0.2s;
      color: var(--ink-muted);
    }
    .faq-toggle::before,
    .faq-toggle::after {
      content: '';
      position: absolute;
      background: currentColor;
      border-radius: 1px;
    }
    .faq-toggle::before {
      width: 10px;
      height: 2px;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
    }
    .faq-toggle::after {
      width: 2px;
      height: 10px;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      transition: transform 0.3s ease;
    }
    .faq-item[open] .faq-toggle {
      background: color-mix(in srgb, var(--accent) 10%, transparent);
      color: var(--accent);
      transform: rotate(45deg);
    }
    .faq-respuesta {
      padding: 0 1.25rem 1.25rem;
      font-size: 0.9rem;
      color: var(--ink-muted);
      line-height: 1.7;
      margin: 0;
    }

    .article-hero-img {
      width: 100%;
      height: auto;
      max-height: 400px;
      object-fit: cover;
      border-radius: 8px;
      margin-bottom: 1.5rem;
    }

    .article-tags-section {
      margin-top: 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--border);
    }
    .article-tags-label {
      font-size: 0.85rem;
      color: var(--ink-muted);
    }
    .article-tags-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 0.5rem;
    }
    .article-tag-badge {
      background: var(--surface-muted);
      color: var(--ink-muted);
      text-decoration: none;
    }

    .article-related-section {
      margin-top: 3rem;
      padding-top: 2rem;
      border-top: 2px solid var(--border);
    }
    .article-related-title {
      font-size: 1.3rem;
      font-weight: 700;
      margin-bottom: 1.25rem;
    }
    .article-related-more {
