---
import StoreIcon from './StoreIcon.astro';
import {
  formatAmazonLastChecked,
  getCachedAmazonAvailability,
  getCachedAmazonImage,
  getCachedAmazonPrice,
  isAmazonProductAvailable,
} from '@/lib/amazon-products';
import { buildAmazonUrl, hasVerifiedCommerceLocale } from '@/i18n/amazon';
import { DEFAULT_LOCALE, type Locale } from '@/i18n/locales';
import { t } from '@/i18n/ui';

interface Props {
  nombre: string;
  descripcion: string;
  precio: string;
  enlaceAmazon?: string;
  imagen?: string;
  etiqueta?: string;
  locale?: Locale;
}

const {
  nombre,
  descripcion,
  precio,
  enlaceAmazon,
  imagen,
  etiqueta,
  locale = DEFAULT_LOCALE,
} = Astro.props;
const ui = t(locale);
const badge = etiqueta || ui.commerce.topPick;

const amazonFinal = enlaceAmazon ? buildAmazonUrl({ href: enlaceAmazon, locale }) : null;

const precioAmazon = getCachedAmazonPrice(enlaceAmazon, precio);
const imagenAmazon = getCachedAmazonImage(enlaceAmazon, imagen || '');
const disponibilidad = locale === DEFAULT_LOCALE ? getCachedAmazonAvailability(enlaceAmazon) : null;
const disponible = locale === DEFAULT_LOCALE ? isAmazonProductAvailable(enlaceAmazon) : null;
const revisado = formatAmazonLastChecked(enlaceAmazon, locale);
const showPrice = locale === DEFAULT_LOCALE || hasVerifiedCommerceLocale(locale);
---

<div class="top-pick">
  <div class="top-pick-badge">🏆 {badge}</div>
  <div class="top-pick-body">
    {imagenAmazon && (
      <div class="top-pick-img-wrap">
        <img src={imagenAmazon} alt={nombre} width="200" height="200" class="top-pick-img" loading="lazy" decoding="async" sizes="(max-width: 540px) 180px, 200px" />
      </div>
    )}
    <div class="top-pick-info">
      <p class="top-pick-nombre">{nombre}</p>
      <p class="top-pick-desc">{descripcion}</p>
      {showPrice && <p class="top-pick-precio">{precioAmazon}</p>}
      {(disponibilidad || revisado) && (
        <p class={`top-pick-availability ${disponible === false ? 'top-pick-availability--out' : ''}`}>
          {disponibilidad && <span>{disponibilidad}</span>}
          {revisado && <span>{ui.commerce.reviewed}: {revisado}</span>}
        </p>
      )}
      {amazonFinal && (
        <div class="top-pick-stores">
          <a
            href={amazonFinal}
            class="affiliate-button amazon"
            target="_blank"
            rel="nofollow noopener noreferrer sponsored"
          >
            <StoreIcon tienda="amazon" size={15} />
              {ui.commerce.viewOnAmazon}{showPrice && precioAmazon ? ` · ${precioAmazon}` : ''}
            <span class="sr-only">({ui.commerce.opensNewTab})</span>
          </a>
        </div>
      )}
    </div>
  </div>
</div>

<style>
.top-pick {
  border: 1px solid var(--accent);
  background: color-mix(in srgb, var(--accent) 4%, var(--surface));
  border-radius: var(--radius);
  padding: 2rem;
  margin: 2.5rem 0;
  position: relative;
  transition: box-shadow var(--dur-hover) var(--ease-out);
}

.top-pick:hover {
  box-shadow: 0 12px 40px color-mix(in srgb, var(--accent) 15%, rgba(0, 0, 0, 0.1));
}

.top-pick-badge {
  position: absolute;
  top: -0.8rem;
  left: 1.25rem;
  background: var(--accent);
  color: var(--accent-ink);
  font-size: 0.72rem;
  font-weight: 700;
  padding: 0.3rem 0.9rem;
  border-radius: var(--radius-full);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.top-pick-body {
  display: flex;
  gap: 1.5rem;
  align-items: flex-start;
  margin-top: 0.25rem;
}

.top-pick-img-wrap {
  flex-shrink: 0;
  background: var(--surface-muted);
  border-radius: var(--radius);
  padding: 0.75rem;
  display: flex;
  align-items: center;
  justify-content: center;
}

.top-pick-img {
  width: 200px;
  height: 200px;
  object-fit: contain;
}

.top-pick-info {
  flex: 1;
  min-width: 0;
}

.top-pick-nombre {
  font-size: 1.2rem;
  font-family: var(--font-display);
  font-weight: 700;
  margin: 0 0 0.4rem;
  color: var(--ink);
  letter-spacing: -0.02em;
}

.top-pick-desc {
  font-size: 0.9rem;
  color: var(--ink-muted);
  margin: 0 0 0.6rem;
  line-height: 1.5;
}

.top-pick-precio {
  font-family: var(--font-display);
  font-size: 1.75rem;
  font-weight: 700;
  color: var(--accent);
  font-variant-numeric: tabular-nums;
  margin: 0 0 1rem;
  letter-spacing: -0.02em;
}

.top-pick-availability {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  align-items: center;
  color: var(--ink-muted);
  font-size: 0.78rem;
  margin: -0.4rem 0 1rem;
}

.top-pick-availability span + span::before {
  content: '·';
  margin-right: 0.5rem;
}

.top-pick-availability--out {
  color: #b91c1c;
  font-weight: 600;
}

/* --- Single store button --- */
.top-pick-stores {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.top-pick-stores .affiliate-button {
  font-size: 0.88rem;
  padding: 0.65rem 1.2rem;
  font-weight: 700;
  border-radius: var(--radius);
}

@media (max-width: 540px) {
  .top-pick-body {
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .top-pick-img {
    width: 180px;
    height: 180px;
  }

  .top-pick-desc {
    text-align: left;
  }

  .top-pick-stores {
    flex-direction: column;
  }

  .top-pick-stores .affiliate-button {
    justify-content: center;
    width: 100%;
    font-size: 0.88rem;
    padding: 0.7rem 1.1rem;
  }
}

:global([data-theme="dark"]) .top-pick {
  background: color-mix(in srgb, var(--accent) 8%, var(--surface));
  border-color: var(--accent);
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border-width: 0;
}
</style>
