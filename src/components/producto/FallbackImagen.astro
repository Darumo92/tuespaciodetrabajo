---
import { DEFAULT_LOCALE, type Locale } from '@/i18n/locales';

interface Props { marca: string; nombre: string; size?: number; locale?: Locale; }
const { marca, nombre, size = 200, locale = DEFAULT_LOCALE } = Astro.props;
const fallbackText = locale === 'en' ? 'no image' : 'sin imagen';
const fallbackLabel = locale === 'en' ? 'no image available' : 'sin imagen disponible';
---
<div class="fallback-img" style={`--s:${size}px`} role="img" aria-label={`${marca} ${nombre} (${fallbackLabel})`}>
  <span class="fb-marca">{marca}</span>
  <span class="fb-nombre">{nombre}</span>
  <span class="fb-nota">{fallbackText}</span>
</div>
<style>
  .fallback-img { width: var(--s); height: var(--s); background: var(--surface-muted); border-radius: var(--radius);
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.2rem; text-align: center; padding: 0.6rem; flex-shrink: 0; }
  .fb-marca { font-family: var(--font-display); font-weight: 700; font-size: 0.8rem; color: var(--ink-muted); text-transform: uppercase; letter-spacing: 0.04em; }
  .fb-nombre { font-family: var(--font-display); font-weight: 700; font-size: 0.95rem; color: var(--ink); line-height: 1.15; }
  .fb-nota { font-size: 0.62rem; color: var(--ink-muted); opacity: 0.7; margin-top: 0.2rem; }
</style>
