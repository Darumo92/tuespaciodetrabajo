---
import type { Producto } from '@/lib/productos';
import { DEFAULT_LOCALE, type Locale } from '@/i18n/locales';

interface Props { producto: Producto; locale?: Locale; }

const { producto: p, locale = DEFAULT_LOCALE } = Astro.props;
const isEn = locale === 'en';
const typeLabel: Record<string, string> = {
  oficial: 'official source',
  review: 'review',
  comunidad: 'community source',
  tienda: 'retailer',
  manual: 'manual check',
};
const sourceLabel = (url: string, fallback: string) => {
  if (!isEn) return fallback;
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return 'Verified source';
  }
};
const sourceMeta = (tipo: string, fecha: string) => isEn
  ? `${typeLabel[tipo] ?? 'source'} · checked ${fecha}`
  : `${tipo} · consultado ${fecha}`;
---

{p.fuentes?.length ? (
  <section class="ficha-fuentes" aria-labelledby="fuentes-producto">
    <h2 id="fuentes-producto">{isEn ? 'Verified sources' : 'Fuentes verificadas'}</h2>
    <ul>
      {p.fuentes.map((f) => (
        <li>
          <a href={f.url} target="_blank" rel="nofollow noopener noreferrer">{sourceLabel(f.url, f.nombre)}</a>
          <span>{sourceMeta(f.tipo, f.fechaConsulta)}</span>
        </li>
      ))}
    </ul>
  </section>
) : null}

<style>
  .ficha-fuentes {
    margin: 2rem 0;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .ficha-fuentes h2 {
    font-size: 1rem;
  }

  .ficha-fuentes ul {
    list-style: none;
    padding: 0;
  }

  .ficha-fuentes li {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.7rem;
    padding: 0.45rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 55%, transparent);
    font-size: 0.86rem;
  }

  .ficha-fuentes span {
    color: var(--ink-muted);
  }
</style>
