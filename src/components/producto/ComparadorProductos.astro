---
import { getTipoConfig } from '@/lib/tipos';
import { catalogPath, localizedTipoSlug } from '@/lib/productos';
import type { Producto } from '@/lib/productos';
import { DEFAULT_LOCALE, type Locale } from '@/i18n/locales';
interface Props { productos: Producto[]; tipo: string; locale?: Locale; }
const { productos, tipo, locale = DEFAULT_LOCALE } = Astro.props;
const isEn = locale === 'en';
const cfg = getTipoConfig(tipo)!;
const labelMap: Record<string, string> = {
  'Valoración por ejes': 'Category scores',
  'Precio y garantía': 'Price and warranty',
  'Construcción': 'Build',
  'Ergonomía': 'Ergonomics',
  'Ajustabilidad': 'Adjustability',
  'Materiales': 'Materials',
  'Comodidad': 'Comfort',
  'Calidad-precio': 'Value',
  'Tramo de precio': 'Price tier',
  'Garantía (años)': 'Warranty',
  'Peso máximo (kg)': 'Max supported weight',
  'Reclinación máx (°)': 'Max recline',
  // escritorio
  'Movimiento y estructura': 'Movement and frame',
  'Velocidad': 'Speed',
  'Estabilidad': 'Stability',
  'Capacidad de carga': 'Load capacity',
  'Rango de altura': 'Height range',
  'Velocidad (mm/s)': 'Speed (mm/s)',
  'Carga máxima (kg)': 'Max load (kg)',
  'Altura máxima (cm)': 'Max height (cm)',
};
const comparador = cfg.comparador.map((fila) => ({
  ...fila,
  grupo: isEn ? labelMap[fila.grupo] ?? fila.grupo : fila.grupo,
  etiqueta: isEn ? labelMap[fila.etiqueta] ?? fila.etiqueta : fila.etiqueta,
}));
const productosRuntime = isEn
  ? productos.map((p) => ({
      slug: p.slug,
      tipo: p.tipo,
      nombre: p.nombre,
      marca: p.marca,
      tramoPrecio: p.tramoPrecio,
      valoracion: p.valoracion,
      valoraciones: p.valoraciones,
      amazon: p.amazon,
      webOficial: p.webOficial,
      specs: p.specs,
    }))
  : productos;
const datos = JSON.stringify({
  productos: productosRuntime,
  comparador,
  locale,
  catalogBase: catalogPath(locale, tipo),
  productBase: catalogPath(locale, tipo),
  typeSlug: localizedTipoSlug(tipo, locale),
});
---
<section class="cmp" data-json={datos} data-tipo={localizedTipoSlug(tipo, locale)}>
  <div id="cmp-out"></div>
  <p id="cmp-empty" class="cmp-empty" hidden>
    {isEn ? 'Choose 2 to 4 products in the ' : 'Elige entre 2 y 4 en el '}
    <a href={catalogPath(locale, tipo)}>{isEn ? 'catalog' : 'catálogo'}</a>
    {isEn ? ' using the compare boxes, then come back here.' : ' (casillas "comparar") y vuelve aquí.'}
  </p>
</section>
<style>
  .cmp-empty { color: var(--ink-muted); }
  .cmp :global(.cmp-scroll) { overflow-x: auto; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); }
  .cmp :global(.cmp-table) { border-collapse: collapse; width: 100%; min-width: 640px; }
  .cmp :global(.cmp-table td), .cmp :global(.cmp-table th) { padding: 0.7rem 0.8rem; border-bottom: 1px solid var(--border); text-align: left; font-size: 0.86rem; vertical-align: middle; }
  .cmp :global(.cmp-table thead td) { background: var(--surface-muted); }
  .cmp :global(.cmp-attr) { color: var(--ink-muted); font-weight: 600; font-size: 0.8rem; position: sticky; left: 0; background: var(--bg); width: 180px; }
  .cmp :global(.cmp-grp td) { background: var(--surface-muted); font-family: var(--font-display); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--ink-muted); }
  .cmp :global(.cmp-name) { font-family: var(--font-display); font-weight: 700; font-size: 0.9rem; }
  .cmp :global(.cmp-name a) { color: inherit; text-decoration: none; }
  .cmp :global(.cmp-global) { font-family: var(--font-display); font-weight: 700; margin-top: 0.2rem; }
  .cmp :global(.cmp-global small) { font-size: 0.6rem; color: var(--ink-muted); font-weight: 500; }
  .cmp :global(.cmp-rm) { font-size: 0.7rem; color: var(--ink-muted); border: 1px solid var(--border); border-radius: 6px; padding: 0.1rem 0.4rem; background: none; cursor: pointer; margin-top: 0.3rem; }
  .cmp :global(.cmp-win) { background: color-mix(in srgb, var(--accent) 8%, var(--surface)); color: var(--ink); }
  .cmp :global(.cmp-wtag) { display: inline-block; font-size: 0.58rem; font-weight: 700; color: var(--accent); text-transform: uppercase; margin-left: 0.35rem; }
  .cmp :global(.cmp-nd) { color: var(--ink-muted); font-style: italic; }
  .cmp :global(.cmp-cta) { display: inline-block; background: var(--accent); color: var(--accent-ink); font-weight: 600; font-size: 0.78rem; padding: 0.45rem 0.9rem; border-radius: var(--radius); text-decoration: none; transition: background var(--dur-hover) var(--ease-out), transform var(--dur-press) var(--ease-out); }
  .cmp :global(.cmp-cta:active) { transform: scale(0.97); }
  .cmp :global(.cmp-legend) { font-size: 0.76rem; color: var(--ink-muted); margin-top: 0.8rem; }
</style>
<script>
  import { ganadoresPorValor, notaGlobal, formatoSpec, etiquetaEnum, tramoTexto, getCampo, buildProductCta, type Producto } from '@/lib/productos';

  const root = document.querySelector('.cmp') as HTMLElement | null;
  if (root) {
    const { productos, comparador, locale, productBase } = JSON.parse(root.dataset.json || '{"productos":[],"comparador":[]}') as {
      productos: Producto[]; comparador: { campo: string; etiqueta: string; direccion?: 'mayor' | 'menor'; grupo: string }[]; locale?: 'es-ES' | 'en'; productBase?: string;
    };
    const currentLocale = locale || 'es-ES';
    const isEn = currentLocale === 'en';
    const productUrl = (slug: string) => `${productBase || `/catalogo/${root.dataset.tipo || ''}/`}${slug}/`;
    const out = root.querySelector('#cmp-out') as HTMLElement;
    const empty = root.querySelector('#cmp-empty') as HTMLElement;
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));
    const ENUM = new Set(['specs.lumbar', 'specs.reposabrazos', 'specs.respaldo']);

    const slugs = (new URLSearchParams(location.search).get('s') || '').split(',').map((x) => x.trim()).filter(Boolean).slice(0, 4);
    const sel = slugs.map((s) => productos.find((p) => p.slug === s)).filter((p): p is Producto => p != null);

    if (sel.length < 2) { empty.hidden = false; }
    else {
      function celda(p: Producto, campo: string): string {
        const v = getCampo(p, campo);
        if (campo === 'tramoPrecio') return tramoTexto(Number(v), currentLocale);
        if (ENUM.has(campo) && typeof v === 'string') return etiquetaEnum(campo.split('.').pop()!, v, currentLocale);
        if (campo.startsWith('valoraciones.')) return v == null ? `<span class="cmp-nd">${isEn ? 'not rated' : 'sin valorar'}</span>` : `<b>${Number(v).toFixed(1)}</b>`;
        const fmt = campo.includes('garantia') ? 'anios' : campo.includes('peso') ? 'kg' : campo.includes('reclin') ? 'grados' : undefined;
        return v == null ? `<span class="cmp-nd">${isEn ? 'n/a' : 'n/d'}</span>` : formatoSpec(v, fmt, currentLocale);
      }
      const head = sel.map((p) => {
        const g = notaGlobal(p);
        const productCta = buildProductCta({ amazon: p.amazon, webOficial: p.webOficial, nombre: p.nombre, marca: p.marca, locale: currentLocale });
        const rel = productCta.sponsored ? 'sponsored nofollow noopener noreferrer' : 'nofollow noopener noreferrer';
        const cta = productCta.href ? `<a class="cmp-cta" href="${esc(productCta.href)}" target="_blank" rel="${rel}">${esc(productCta.label)}</a><br>` : '';
        return `<td><div class="cmp-name"><a href="${productUrl(esc(p.slug))}">${esc(p.nombre)}</a></div>${g != null ? `<div class="cmp-global">${g.toFixed(1)}<small>/10</small></div>` : ''}${cta}<button class="cmp-rm" data-slug="${esc(p.slug)}">✕ ${isEn ? 'remove' : 'quitar'}</button></td>`;
      }).join('');

      let lastGrupo = '';
      const body = comparador.map((fila) => {
        let pre = '';
        if (fila.grupo !== lastGrupo) { lastGrupo = fila.grupo; pre = `<tr class="cmp-grp"><td class="cmp-attr">${esc(fila.grupo)}</td>${sel.map(() => '<td></td>').join('')}</tr>`; }
        const gan = fila.direccion ? ganadoresPorValor(sel.map((p) => ({ slug: p.slug, valor: (getCampo(p, fila.campo) as number | null) })), fila.direccion) : [];
        const cells = sel.map((p) => {
          const win = gan.includes(p.slug);
          return `<td class="${win ? 'cmp-win' : ''}">${celda(p, fila.campo)}${win ? `<span class="cmp-wtag">${isEn ? 'best' : 'mejor'}</span>` : ''}</td>`;
        }).join('');
        return `${pre}<tr><td class="cmp-attr">${esc(fila.etiqueta)}</td>${cells}</tr>`;
      }).join('');

      out.innerHTML = `<div class="cmp-scroll"><table class="cmp-table"><thead><tr><td class="cmp-attr"></td>${head}</tr></thead><tbody>${body}</tbody></table></div><p class="cmp-legend">${isEn ? 'Highlighted cell = best value in that row. "n/a"/"not rated" cannot win. Scores are editorial.' : 'Celda resaltada = mejor valor de la fila. "n/d"/"sin valorar" no gana. Valoraciones por ejes editoriales.'}</p>`;
      out.querySelectorAll('.cmp-rm').forEach((b) => b.addEventListener('click', () => {
        const slug = (b as HTMLElement).dataset.slug;
        const rest = sel.filter((p) => p.slug !== slug).map((p) => p.slug);
        location.search = rest.length ? `?s=${rest.join(',')}` : '';
      }));
    }
  }
</script>
