---
import type { Producto } from '@/lib/productos';
import { DEFAULT_LOCALE, type Locale } from '@/i18n/locales';

interface Props { producto: Producto; locale?: Locale; }

const { producto: p, locale = DEFAULT_LOCALE } = Astro.props;
const isEn = locale === 'en';
const items = isEn
  ? [
      'Scores are based on verified specifications, category fit and editorial weighting for remote-work use.',
      'Product pages avoid unverified price claims; always check current price and availability before buying.',
      'English product profiles use structured verified data unless a fully edited product review is available.',
    ]
  : p.metodologia ?? [];
---

{items.length ? (
  <section class="ficha-metodo" aria-labelledby="metodo-producto">
    <h2 id="metodo-producto">{isEn ? 'How this product is assessed' : 'Cómo se ha valorado'}</h2>
    <ul>{items.map((item) => <li>{item}</li>)}</ul>
  </section>
) : null}

<style>
  .ficha-metodo {
    margin: 2rem 0;
    padding: 1rem 1.15rem;
    border-left: 3px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 5%, var(--surface));
  }

  .ficha-metodo h2 {
    margin-top: 0;
    font-size: 1rem;
  }

  .ficha-metodo ul {
    margin: 0;
    padding-left: 1.2rem;
  }

  .ficha-metodo li + li {
    margin-top: 0.35rem;
  }
</style>
