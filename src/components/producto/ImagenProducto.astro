---
import FallbackImagen from './FallbackImagen.astro';
import { DEFAULT_LOCALE, type Locale } from '@/i18n/locales';

interface Props { imagen?: string; imagenAlt?: string; marca: string; nombre: string; size?: number; locale?: Locale; }
const { imagen, imagenAlt, marca, nombre, size = 200, locale = DEFAULT_LOCALE } = Astro.props;
const tieneImagen = imagen != null && imagen.trim() !== '';
const alt = locale === 'en' ? `${marca} ${nombre} product image` : (imagenAlt ?? nombre);
---
{tieneImagen ? (
  <img src={imagen} alt={alt} width={size} height={size} loading="lazy" decoding="async" class="img-prod" style={`--img-box:${size}px`} />
) : (
  <FallbackImagen marca={marca} nombre={nombre} size={size} locale={locale} />
)}
<style>
  .img-prod {
    width: var(--img-box, 200px);
    height: var(--img-box, 200px);
    max-width: 100%;
    object-fit: contain;
    /* Product photos already include a white canvas, so the box stays white
       and letterbox bars blend with the image in light and dark themes. */
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    flex-shrink: 0;
  }
</style>
