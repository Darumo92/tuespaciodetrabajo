---
import FallbackImagen from './FallbackImagen.astro';
interface Props { imagen?: string; imagenAlt?: string; marca: string; nombre: string; size?: number; }
const { imagen, imagenAlt, marca, nombre, size = 200 } = Astro.props;
const tieneImagen = imagen != null && imagen.trim() !== '';
---
{tieneImagen ? (
  <img src={imagen} alt={imagenAlt ?? nombre} width={size} height={size} loading="lazy" decoding="async" class="img-prod" style={`--img-box:${size}px`} />
) : (
  <FallbackImagen marca={marca} nombre={nombre} size={size} />
)}
<style>
  .img-prod {
    width: var(--img-box, 200px);
    height: var(--img-box, 200px);
    max-width: 100%;
    object-fit: contain;
    /* Las fotos de producto llevan lienzo blanco horneado: la caja va siempre
       blanca para que las barras del letterbox se fundan con la foto en modo
       claro y oscuro (si no, en oscuro las barras salen negras). */
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    flex-shrink: 0;
  }
</style>
