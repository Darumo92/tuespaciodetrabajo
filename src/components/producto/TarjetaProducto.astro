---
import ImagenProducto from './ImagenProducto.astro';
import { localizedProductName, notaGlobal, tramoTexto, datosFiltrado, construirChips, productPath, textoBuscable, type Producto } from '@/lib/productos';
import { getTipoConfig } from '@/lib/tipos';
import { DEFAULT_LOCALE, type Locale } from '@/i18n/locales';

interface Props { producto: Producto; locale?: Locale; }

const { producto: p, locale = DEFAULT_LOCALE } = Astro.props;
const global = notaGlobal(p);
const cfg = getTipoConfig(p.tipo);
const dataAttrs = cfg ? datosFiltrado(p, cfg) : {};
const chips = cfg ? construirChips(p, cfg, locale) : [];
const displayName = localizedProductName(p, locale);
const buscable = textoBuscable(p);
---

<article class="card" data-slug={p.slug} data-buscar={buscable} {...dataAttrs}>
  <label class="card-cmp">
    <input type="checkbox" class="cmp-chk" value={p.slug} />
    {locale === 'en' ? 'compare' : 'comparar'} <span class="sr-only">{displayName}</span>
  </label>
  <ImagenProducto imagen={p.imagen} imagenAlt={p.imagenAlt} marca={p.marca} nombre={displayName} size={110} locale={locale} />
  <div class="card-info">
    <span class="card-brand">{p.marca}</span>
    <a class="card-name" href={productPath(p, locale)}>{displayName}</a>
    <p class="card-line">
      {global != null && <span class="card-score">{global.toFixed(1)}/10</span>}
      <span class="card-price">{tramoTexto(p.tramoPrecio, locale)}</span>
    </p>
    <div class="card-chips">
      {chips.map((c) => <span class={`chip${c.nd ? ' chip-nd' : ''}`}>{c.texto}</span>)}
    </div>
  </div>
</article>

<style>
  .card { position: relative; display: flex; gap: 1rem; align-items: flex-start; border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; background: var(--bg); }
  .card.cmp-sel { border-color: var(--accent); box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 35%, transparent); }
  .card-cmp { position: absolute; top: 0.6rem; right: 0.6rem; display: flex; align-items: center; gap: 0.3rem; font-size: 0.72rem; color: var(--ink-muted); background: var(--bg); border: 1px solid var(--border); border-radius: 8px; padding: 0.2rem 0.5rem; cursor: pointer; }
  .card-cmp { transition: border-color var(--dur-hover) var(--ease-out), transform var(--dur-press) var(--ease-out); }
  .card-cmp:active { transform: scale(0.97); }
  .card-info { flex: 1; min-width: 0; }
  .card-brand { font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--ink-muted); }
  .card-name { font-family: var(--font-display); font-weight: 700; color: var(--ink); text-decoration: none; display: block; margin: 0.05rem 0 0.3rem; }
  .card-name:hover { color: var(--accent); }
  .card-line { display: flex; align-items: center; flex-wrap: wrap; gap: 0.6rem; margin: 0 0 0.5rem; font-weight: 700; font-size: 0.92rem; }
  .card-score { background: var(--ink); color: var(--bg); font-family: var(--font-display); font-size: 0.78rem; border-radius: var(--radius-sm); padding: 0.1rem 0.45rem; }
  .card-price { color: var(--accent); }
  .card-chips { display: flex; flex-wrap: wrap; gap: 0.3rem; margin-bottom: 0.7rem; }
  .chip { font-size: 0.7rem; background: var(--surface-muted); color: var(--ink); border-radius: var(--radius-sm); padding: 0.1rem 0.45rem; }
  .chip-nd { color: var(--ink-muted); font-style: italic; }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border-width: 0;
  }
</style>
