---
import { notaGlobal, type Producto } from '@/lib/productos';
import { getTipoConfig } from '@/lib/tipos';
import { DEFAULT_LOCALE, type Locale } from '@/i18n/locales';
interface Props { producto: Producto; locale?: Locale; }
const { producto, locale = DEFAULT_LOCALE } = Astro.props;
const isEn = locale === 'en';
const cfg = getTipoConfig(producto.tipo);
const v = producto.valoraciones as unknown as Record<string, number | null>;
const rationale = producto.scoreRationale as Record<string, string | undefined> | undefined;
const labels: Record<string, string> = isEn ? {
  ergonomia: 'Ergonomics',
  ajustabilidad: 'Adjustability',
  materiales: 'Materials',
  comodidad: 'Comfort',
  calidadPrecio: 'Value',
} : {};
const ejes = (cfg?.ejes ?? []).map((e) => ({
  etiqueta: labels[e.clave] ?? e.etiqueta,
  valor: v?.[e.clave] ?? null,
  rationale: isEn ? undefined : rationale?.[e.clave],
}));
const global = notaGlobal(producto);
---
<section class="vejes">
  <div class="vejes-head">
    <h2>{isEn ? 'Category scores' : 'Valoración por ejes'}</h2>
    <span class="vejes-tag">{isEn ? 'editorial · specs based' : 'editorial · specs + comunidad'}</span>
  </div>
  {global != null && (<p class="vejes-global"><strong>{global.toFixed(1)}</strong><span>/10 · {isEn ? 'overall score' : 'nota global'}</span></p>)}
  <div class="vejes-list">
    {ejes.map((e) => (
      <div class={`vejes-row${e.valor == null ? ' vejes-nd' : ''}`}>
        <span class="vejes-lbl">{e.etiqueta}</span>
        <span class="vejes-bar" style={e.valor == null ? undefined : `--pct:${e.valor * 10}%`} aria-hidden="true"></span>
        <span class="vejes-val">{e.valor == null ? (isEn ? 'not rated' : 'sin valorar') : e.valor.toFixed(1)}</span>
        {e.rationale && <p class="vejes-rationale">{e.rationale}</p>}
      </div>
    ))}
  </div>
</section>
<style>
  .vejes { margin: 1.5rem 0 2rem; }
  .vejes-head { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  .vejes-head h2 { margin: 0; }
  .vejes-tag { font-size: 0.62rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--ink-muted); background: var(--surface-muted); padding: 0.2rem 0.5rem; border-radius: 6px; }
  .vejes-global { font-family: var(--font-display); margin: 0.5rem 0 1rem; }
  .vejes-global strong { font-size: 1.4rem; }
  .vejes-global span { color: var(--ink-muted); font-size: 0.8rem; font-weight: 500; }
  .vejes-list { display: grid; gap: 0.6rem; max-width: 680px; }
  .vejes-row { display: grid; grid-template-columns: 130px 1fr 44px; align-items: center; gap: 0.85rem; font-size: 0.85rem; }
  .vejes-lbl { color: var(--ink-muted); }
  .vejes-bar { position: relative; height: 2px; }
  .vejes-bar::before { content: ""; position: absolute; left: 0; top: 0; height: 2px; width: var(--pct, 0); background: var(--accent); }
  .vejes-val { font-family: var(--font-display); font-weight: 700; font-size: 0.85rem; text-align: right; font-variant-numeric: tabular-nums; }
  .vejes-nd .vejes-bar { border-top: 1px dashed var(--border); }
  .vejes-nd .vejes-bar::before { content: none; }
  .vejes-nd .vejes-val { color: var(--ink-muted); font-weight: 500; font-size: 0.72rem; }
  .vejes-rationale { grid-column: 1 / -1; margin: -0.35rem 0 0; color: var(--ink-muted); font-size: 0.78rem; line-height: 1.45; }
</style>
