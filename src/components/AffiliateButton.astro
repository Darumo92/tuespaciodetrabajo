---
import StoreIcon from './StoreIcon.astro';
import { formatAmazonLastChecked, getCachedAmazonAvailability, isAmazonProductAvailable } from '@/lib/amazon-products';
import { buildAmazonUrl } from '@/i18n/amazon';
import { DEFAULT_LOCALE, type Locale } from '@/i18n/locales';
import { t } from '@/i18n/ui';

interface Props {
  href: string;
  tienda?: 'amazon' | 'default';
  texto?: string;
  locale?: Locale;
}

const { href, tienda = 'default', texto, locale = DEFAULT_LOCALE } = Astro.props;
const ui = t(locale);

const tiendaInfo: Record<string, { label: string }> = {
  amazon: { label: ui.commerce.viewOnAmazon },
  default: { label: ui.commerce.viewOffer },
};

const info = tiendaInfo[tienda];
const label = texto || info.label;

const finalHref = tienda === 'amazon' ? buildAmazonUrl({ href, locale }) : href;

const disponibilidad = tienda === 'amazon' && locale === DEFAULT_LOCALE ? getCachedAmazonAvailability(href) : null;
const disponible = tienda === 'amazon' && locale === DEFAULT_LOCALE ? isAmazonProductAvailable(href) : null;
const revisado = tienda === 'amazon' ? formatAmazonLastChecked(href, locale) : null;
const title = [disponibilidad, revisado && `${ui.commerce.reviewed}: ${revisado}`].filter(Boolean).join(' · ') || undefined;
---

<a
  href={finalHref}
  class={`affiliate-button ${tienda !== 'default' ? tienda : ''} ${disponible === false ? 'affiliate-button--unavailable' : ''}`}
  target="_blank"
  rel="nofollow noopener noreferrer sponsored"
  title={title}
  data-amazon-available={disponible === null ? undefined : String(disponible)}
  data-amazon-checked={revisado || undefined}
>
  <StoreIcon tienda={tienda} size={15} />
  {label}
  <span class="sr-only">({ui.commerce.opensNewTab})</span>
</a>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>
