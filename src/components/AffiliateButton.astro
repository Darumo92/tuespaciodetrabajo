---
import StoreIcon from './StoreIcon.astro';
import { formatAmazonLastChecked, getCachedAmazonAvailability, isAmazonProductAvailable } from '@/lib/amazon-products';

interface Props {
  href: string;
  tienda?: 'amazon' | 'default';
  texto?: string;
}

const { href, tienda = 'default', texto } = Astro.props;

const tiendaInfo: Record<string, { label: string }> = {
  amazon: { label: 'Ver en Amazon' },
  default: { label: 'Ver oferta' },
};

const info = tiendaInfo[tienda];
const label = texto || info.label;

const normalizedHref = tienda === 'amazon' && href.startsWith('/dp/')
  ? `https://www.amazon.es${href}`
  : href;

const finalHref = tienda === 'amazon' && !normalizedHref.includes('tag=')
  ? `${normalizedHref}${normalizedHref.includes('?') ? '&' : '?'}tag=tuespaciodet-21`
  : normalizedHref;

const disponibilidad = tienda === 'amazon' ? getCachedAmazonAvailability(href) : null;
const disponible = tienda === 'amazon' ? isAmazonProductAvailable(href) : null;
const revisado = tienda === 'amazon' ? formatAmazonLastChecked(href) : null;
const title = [disponibilidad, revisado && `Revisado: ${revisado}`].filter(Boolean).join(' · ') || undefined;
---

<a
  href={finalHref}
  class={`affiliate-button ${tienda !== 'default' ? tienda : ''} ${disponible === false ? 'affiliate-button--unavailable' : ''}`}
  target="_blank"
  rel="nofollow noopener noreferrer sponsored"
  title={title}
  data-amazon-available={disponible === null ? undefined : String(disponible)}
  data-amazon-checked={revisado || undefined}
>
  <StoreIcon tienda={tienda} size={15} />
  {label}
  <span class="sr-only">(se abre en nueva pestaña)</span>
</a>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>
