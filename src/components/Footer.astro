---
import LogoIcon from './LogoIcon.astro';
import { DEFAULT_LOCALE, type Locale } from '@/i18n/locales';
import { localizedPath } from '@/i18n/routes';
import { t } from '@/i18n/ui';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const ui = t(locale);

const categorias = locale === DEFAULT_LOCALE
  ? [
      { href: localizedPath(locale, ['sillas']), label: ui.categories.sillas },
      { href: localizedPath(locale, ['escritorios']), label: ui.categories.escritorios },
      { href: localizedPath(locale, ['accesorios']), label: ui.categories.accesorios },
      { href: localizedPath(locale, ['ambiente']), label: ui.categories.ambiente },
    ]
  : [
      { href: localizedPath(locale, ['chairs']), label: ui.categories.sillas },
      { href: localizedPath(locale, ['desks']), label: ui.categories.escritorios },
      { href: localizedPath(locale, ['accessories']), label: ui.categories.accesorios },
      { href: localizedPath(locale, ['workspace']), label: ui.categories.ambiente },
      { href: localizedPath(locale, ['audio-video']), label: ui.categories['audio-video'] },
    ];

const exploreLinks = locale === DEFAULT_LOCALE
  ? [
      { href: localizedPath(locale, ['guias']), label: ui.nav.guides },
      { href: localizedPath(locale, ['herramientas']), label: ui.nav.tools },
      { href: localizedPath(locale, ['articulos']), label: ui.footer.allArticles },
      { href: localizedPath(locale, ['sobre-mi']), label: ui.footer.about },
      { href: localizedPath(locale, ['metodologia-editorial']), label: ui.footer.editorialMethod },
      { href: localizedPath(locale, ['como-probamos-productos']), label: ui.footer.testingMethod },
    ]
  : [
      { href: localizedPath(locale, ['catalog']), label: ui.nav.catalog },
      { href: localizedPath(locale, ['guides']), label: ui.nav.guides },
      { href: localizedPath(locale, ['articles']), label: ui.footer.allArticles },
      { href: localizedPath(locale, ['search']), label: ui.nav.search },
      { href: localizedPath(locale, ['tools']), label: ui.nav.tools },
      { href: localizedPath(locale, ['about']), label: ui.footer.about },
      { href: localizedPath(locale, ['editorial-methodology']), label: ui.footer.editorialMethod },
      { href: localizedPath(locale, ['how-we-test-products']), label: ui.footer.testingMethod },
    ];

const legalLinks = locale === DEFAULT_LOCALE
  ? [
      { href: localizedPath(locale, ['politica-privacidad']), label: ui.footer.privacy },
      { href: localizedPath(locale, ['aviso-legal']), label: ui.footer.legalNotice },
      { href: localizedPath(locale, ['cookies']), label: ui.footer.cookies },
    ]
  : [
      { href: localizedPath(locale, ['privacy-policy']), label: ui.footer.privacy },
      { href: localizedPath(locale, ['legal-notice']), label: ui.footer.legalNotice },
      { href: localizedPath(locale, ['cookies']), label: ui.footer.cookies },
    ];

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href={localizedPath(locale)} class="logo footer-logo">
          <LogoIcon size={28} />
          Tu Espacio de <span class="footer-logo-accent">Trabajo</span>
        </a>
        <p class="footer-brand-text">
          {locale === 'en'
            ? 'Buying guides and product comparisons for a healthier home office.'
            : 'Guías de compra y comparativas de productos para tu home office.'}
        </p>
      </div>

      <nav class="footer-col" aria-label={ui.footer.categories}>
        <p class="footer-heading">{ui.footer.categories}</p>
        <ul class="footer-links" role="list">
          {categorias.map(c => (
            <li><a href={c.href}>{c.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="footer-col" aria-label={ui.footer.explore}>
        <p class="footer-heading">{ui.footer.explore}</p>
        <ul class="footer-links" role="list">
          {exploreLinks.map(link => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="footer-col" aria-label={ui.footer.legal}>
        <p class="footer-heading">{ui.footer.legal}</p>
        <ul class="footer-links" role="list">
          {legalLinks.map(link => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="footer-affiliate-notice">
      {ui.footer.affiliateNotice}
    </div>

    <div class="footer-bottom">
      <p>&copy; {year} tuespaciodetrabajo.com &middot; {ui.footer.rights}</p>
    </div>
  </div>
</footer>
<a href="#main-content" class="footer-back-top" aria-label={ui.article.backToTop}>↑</a>
