---
import type { Locale } from '@/i18n/locales';
import CardProducto from './CardProducto.astro';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const isEn = locale === 'en';
---

<section class="selector-output" data-selector-output hidden>
  <div class="calculating" data-calculating aria-live="polite" aria-atomic="true">
    <p>{isEn ? 'Calculating your best matches' : 'Calculando tus mejores opciones'}</p>
    <span class="calculating-dots" aria-hidden="true"><i></i><i></i><i></i></span>
  </div>

  <div data-results hidden>
    <header class="results-heading">
      <h2 data-results-heading tabindex="-1">{isEn ? 'Your top 3 matches' : 'Tus 3 mejores opciones'}</h2>
      <p>{isEn ? 'Ordered by fit with your answers and verified product data.' : 'Ordenadas por encaje con tus respuestas y datos de producto verificados.'}</p>
    </header>
    <div class="result-tabs" data-result-tabs data-label={isEn ? 'Recommended product' : 'Producto recomendado'}>
      {[1, 2, 3].map((rank) => (
        <button
          type="button"
          data-result-tab={rank - 1}
          id={`selector-result-tab-${rank}`}
          aria-controls={`selector-result-${rank}`}
          tabindex="-1"
        >{rank}</button>
      ))}
    </div>
    <div class="results-grid" data-results-grid></div>
    <div class="result-actions">
      <a class="action action-primary" data-action-compare>{isEn ? 'Compare the 3' : 'Comparar los 3'}</a>
      <a class="action action-secondary" data-action-catalog>{isEn ? 'View full catalog' : 'Ver catálogo completo'}</a>
      <button class="action action-secondary" type="button" data-action-copy>{isEn ? 'Copy link' : 'Copiar enlace'}</button>
      <button class="action action-text" type="button" data-action-reset>{isEn ? 'Start over' : 'Empezar de nuevo'}</button>
    </div>
    <p class="result-feedback" data-result-feedback role="status" aria-live="polite"></p>
  </div>

  <div class="result-empty" data-result-empty hidden role="alert">
    <h2 data-result-empty-heading tabindex="-1">{isEn ? 'We could not create recommendations' : 'No hemos podido crear recomendaciones'}</h2>
    <p>{isEn ? 'Try changing one of your answers or browse the full catalog.' : 'Prueba a cambiar una respuesta o consulta el catálogo completo.'}</p>
  </div>
  <CardProducto />
</section>

<style>
  .selector-output { margin-top: 1.25rem; }
  .calculating { min-height: 18rem; display: grid; place-content: center; justify-items: center; gap: 0.8rem; color: var(--ink-muted); text-align: center; }
  .calculating p { font-family: var(--font-display); font-size: 1.05rem; font-weight: 680; color: var(--ink); }
  .calculating-dots { display: flex; gap: 0.35rem; }
  .calculating-dots i { width: 0.45rem; height: 0.45rem; border-radius: 50%; background: var(--accent); animation: selector-dot 900ms ease-in-out infinite alternate; }
  .calculating-dots i:nth-child(2) { animation-delay: 150ms; }
  .calculating-dots i:nth-child(3) { animation-delay: 300ms; }
  @keyframes selector-dot { from { opacity: 0.3; transform: translateY(0); } to { opacity: 1; transform: translateY(-0.3rem); } }
  .results-heading { max-width: 44rem; margin-bottom: 1.4rem; }
  .results-heading h2, .result-empty h2 { font-family: var(--font-display); font-size: 1.5rem; line-height: 1.2; letter-spacing: -0.025em; text-wrap: balance; }
  .results-heading p, .result-empty p { margin-top: 0.45rem; color: var(--ink-muted); font-size: 0.9rem; }
  .results-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.85rem; }
  .result-tabs { display: none; }
  .result-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 0.55rem; margin-top: 1.25rem; padding-top: 1.1rem; border-top: 1px solid var(--border); }
  .action { min-height: 2.7rem; display: inline-flex; align-items: center; justify-content: center; padding: 0.55rem 0.9rem; border-radius: var(--radius); font: inherit; font-size: 0.84rem; font-weight: 700; cursor: pointer; text-decoration: none; }
  .action-primary { border: 1px solid var(--accent); background: var(--accent); color: var(--accent-ink); }
  .action-primary:hover { background: var(--accent-hover); color: var(--accent-ink); }
  .action-secondary { border: 1px solid var(--border-strong); background: var(--surface); color: var(--ink); }
  .action-secondary:hover { border-color: var(--accent); color: var(--accent); }
  .action-text { border: 0; background: transparent; color: var(--ink-muted); }
  .action-text:hover { color: var(--ink); }
  .result-feedback { min-height: 1.5rem; margin-top: 0.55rem; color: var(--ink-muted); font-size: 0.8rem; }
  .result-empty { padding: 1.2rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface-muted); }
  @media (max-width: 720px) {
    .result-tabs { display: flex; gap: 0.4rem; margin-bottom: 0.75rem; }
    .result-tabs button { width: 2.75rem; height: 2.75rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); color: var(--ink-muted); font: inherit; font-weight: 750; cursor: pointer; }
    .result-tabs button[aria-selected="true"] { border-color: var(--accent); background: var(--accent); color: var(--accent-ink); }
    .results-grid { display: block; }
    .result-actions { align-items: stretch; }
    .action { flex: 1 1 10rem; }
  }
  @media (prefers-reduced-motion: reduce) { .calculating-dots i { animation: none; opacity: 1; } }
</style>
